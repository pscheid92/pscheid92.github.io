// Speech-to-text for the spelling trainer, for browsers without their own
// speech recognition (Brave, Firefox). Holds the Gemini API key, so the static
// site never sees it.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "speech",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",
    "routes": [{"pattern": "speech.patrickscheid.de", "custom_domain": true}],
    "vars": {
        "ALLOWED_ORIGINS": "https://patrickscheid.de,http://localhost:4321",
    },
    // Per client IP: 20 transcriptions a minute is plenty for a person, and
    // keeps the endpoint useless as a free transcription service.
    "ratelimits": [
        {"name": "PER_IP", "namespace_id": "1001", "simple": {"limit": 20, "period": 60}},
    ],
    // The key is a secret: `wrangler secret put GEMINI_API_KEY`, locally in .dev.vars.
}
