---
import type {CollectionEntry} from 'astro:content';
import Layout from './Layout.astro';

type Props = CollectionEntry<'projects'>['data'];

const {title, description, language, secondaryLanguage, github, liveUrl, kind, topics = []} = Astro.props;
const external = (url: string) => !url.startsWith('/');
---

<Layout title={`${title} - Patrick Scheid`} description={description} pageClass="site page-project">
    <article>
        <header class="grid post-header">
            <p class="index project-meta">
                <span>{kind}</span>
                <span>{[language, secondaryLanguage].filter(Boolean).join(', ')}</span>
                {topics.length > 0 && <span>{topics.join(', ')}</span>}
            </p>
            <div class="wide">
                <h1 class="project-title">{title}</h1>
                <p class="dek">{description}</p>
                <p class="project-links">
                    {liveUrl && <a href={liveUrl} rel={external(liveUrl) ? 'noopener' : undefined}>Open app &rarr;</a>}
                    {github && <a href={github}>Source on GitHub &rarr;</a>}
                </p>
            </div>
        </header>

        <div class="grid">
            <div class="prose">
                <slot/>
            </div>
        </div>

        <footer class="grid project-footer">
            <a href="/projects/">&larr; All projects</a>
        </footer>
    </article>
</Layout>

<style>
    .post-header {
        margin-bottom: 2.5rem;
    }

    .project-meta {
        margin: 0;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--color-text-muted);
    }

    .project-title {
        font-size: 2.5rem;
        line-height: 1.12;
        letter-spacing: -0.02em;
        margin: 0 0 0.75rem;
    }

    .dek {
        font-family: var(--font-text);
        font-size: 1.3rem;
        line-height: 1.5;
        color: var(--color-text-muted);
        margin: 0;
        max-width: var(--measure);
    }

    .project-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin: 1.25rem 0 0;
        font-weight: 700;
    }

    .project-footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        font-weight: 700;
    }

    @media (min-width: 64rem) {
        .project-meta span {
            display: block;
        }

        .project-meta {
            padding-top: 0.55rem;
        }
    }

    @media (max-width: 63.99rem) {
        .project-meta {
            display: flex;
            flex-wrap: wrap;
            margin-bottom: 0.75rem;
        }

        .project-meta span + span::before {
            content: "·";
            margin: 0 0.45em;
        }
    }

    @media (max-width: 720px) {
        .project-title {
            font-size: 2rem;
        }

        .dek {
            font-size: 1.15rem;
        }
    }
</style>
