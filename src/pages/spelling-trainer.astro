---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Spelling Alphabet Trainer - Patrick Scheid"
    description="Practise the NATO alphabet, the German Buchstabiertafel and the BOS Inland-Alphabet: spell random words by keyboard or voice and get per-letter feedback."
    pageClass="page-spelling-trainer"
>
    <section class="trainer-shell" aria-labelledby="trainer-title">
        <div class="page-header">
            <p class="eyebrow">Training tool</p>
            <h1 id="trainer-title">Spelling Alphabet Trainer</h1>
            <p class="tagline">Alfa, Bravo, Charlie — or Anton, Berta, Cäsar. Spell the word, letter by letter.</p>
        </div>

        <fieldset class="modes" id="modes">
            <legend class="sr-only">Spelling alphabet</legend>
            <label><input type="radio" name="mode" value="nato" checked /><span>NATO</span></label>
            <label><input type="radio" name="mode" value="de" /><span>Buchstabiertafel</span></label>
            <label><input type="radio" name="mode" value="bos" /><span>BOS</span></label>
        </fieldset>

        <div class="board" id="board" aria-live="polite"></div>

        <!-- Answer by typing or speaking: the mic sits in the field, Check beside it. -->
        <form class="entry" id="spell-form">
            <div class="field">
                <input
                    id="spell-input"
                    type="text"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                    placeholder="Type or say code words…"
                    aria-label="Code words"
                />
                <button type="button" id="mic" aria-pressed="false" aria-label="Speak the code words">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <rect x="9" y="3" width="6" height="11" rx="3" />
                        <path d="M5 11a7 7 0 0 0 14 0" />
                        <line x1="12" y1="18" x2="12" y2="21" />
                    </svg>
                </button>
            </div>
            <button type="submit" id="check-btn">Check</button>
        </form>

        <p class="hint" id="hint"></p>
        <!-- While recording: level meter, timer and microphone choice; while loading: a bar. -->
        <div class="status" id="model-download" hidden>
            <div class="status-line">
                <span class="level-meter" id="level-meter" aria-hidden="true" hidden></span>
                <progress id="model-progress"></progress>
                <span id="model-elapsed"></span>
            </div>
            <label class="mic-choice" id="mic-choice" hidden>
                Microphone
                <select id="mic-select"></select>
            </label>
        </div>

        <div class="actions">
            <button type="button" id="new-word">New word</button>
            <button type="button" id="show-answer">Show answer</button>
            <button type="button" id="ref-toggle" aria-expanded="false" aria-controls="ref-panel">Show alphabet</button>
        </div>
    </section>

    <aside class="ref-panel" id="ref-panel" aria-labelledby="ref-title" hidden>
        <div class="ref-head">
            <h2 id="ref-title">Reference table</h2>
            <button type="button" class="ref-close" id="ref-close" aria-label="Close reference table">×</button>
        </div>
        <div id="ref-body"></div>
    </aside>
</Layout>

<script>
    import {buildIndex, check, decode, isComplete, liveDecode, normalize, primaryAliases, tokenize} from '../lib/spelling';
    import type {AliasIndex, Row} from '../lib/spelling';
    import {modeTables} from '../data/spelling-alphabets';
    import type {Mode} from '../data/spelling-alphabets';
    import {englishWords, germanWords} from '../data/spelling-words';

    const board = document.getElementById('board') as HTMLDivElement;
    const form = document.getElementById('spell-form') as HTMLFormElement;
    const input = document.getElementById('spell-input') as HTMLInputElement;
    const micButton = document.getElementById('mic') as HTMLButtonElement;
    const modelDownload = document.getElementById('model-download') as HTMLDivElement;
    const modelElapsed = document.getElementById('model-elapsed') as HTMLSpanElement;
    const modelProgress = document.getElementById('model-progress') as HTMLProgressElement;
    const levelMeter = document.getElementById('level-meter') as HTMLSpanElement;
    const micChoice = document.getElementById('mic-choice') as HTMLLabelElement;
    const micSelect = document.getElementById('mic-select') as HTMLSelectElement;
    const newWordButton = document.getElementById('new-word') as HTMLButtonElement;
    const showAnswerButton = document.getElementById('show-answer') as HTMLButtonElement;
    const hint = document.getElementById('hint') as HTMLParagraphElement;
    const refTitle = document.getElementById('ref-title') as HTMLElement;
    const refBody = document.getElementById('ref-body') as HTMLDivElement;
    const refPanel = document.getElementById('ref-panel') as HTMLElement;
    const refToggle = document.getElementById('ref-toggle') as HTMLButtonElement;
    const refClose = document.getElementById('ref-close') as HTMLButtonElement;
    const modeInputs = Array.from(document.querySelectorAll<HTMLInputElement>('#modes input[name="mode"]'));

    const MODE_LABELS: Record<Mode, string> = {
        nato: 'NATO alphabet',
        de: 'Buchstabiertafel (DIN 5009)',
        bos: 'BOS Inland-Alphabet (DV 810)',
    };
    const DEFAULT_HINT = 'Spell the word with code words: type them and press Enter, or press the mic and say them.';

    const storage = {
        get(key: string): string | null {
            try {
                return localStorage.getItem(`spelling-trainer.${key}`);
            } catch {
                return null;
            }
        },
        set(key: string, value: string) {
            try {
                localStorage.setItem(`spelling-trainer.${key}`, value);
            } catch {
                /* private mode etc. — stats just won't persist */
            }
        },
    };

    let mode: Mode = 'nato';
    const storedMode = storage.get('mode');
    if (storedMode === 'nato' || storedMode === 'de' || storedMode === 'bos') {
        mode = storedMode;
    } else if (storedMode === 'din2022') {
        mode = 'de'; // migrate values stored by the earlier DIN-based modes
    } else if (storedMode === 'din1996' || storedMode === 'lenient') {
        mode = 'bos';
    }

    let index: AliasIndex = buildIndex(modeTables[mode]);
    let answers = primaryAliases(modeTables[mode]);
    let currentWord = '';
    let previousWord = '';
    let answerShown = false;
    let wordSolved = false;

    function wordList(): string[] {
        return mode === 'nato' ? englishWords : germanWords;
    }

    function displayLetter(letters: string): string {
        return letters === 'ß' ? 'ß' : letters.charAt(0).toUpperCase() + letters.slice(1);
    }

    function makeTile(letter: string, cls: string, sub: string): HTMLDivElement {
        const cell = document.createElement('div');
        cell.className = `cell ${cls}`.trim();
        const box = document.createElement('div');
        box.className = 'tile';
        const letterEl = document.createElement('span');
        letterEl.className = 'tile-letter';
        letterEl.textContent = letter;
        box.append(letterEl);
        const subEl = document.createElement('span');
        subEl.className = 'tile-sub';
        subEl.textContent = sub;
        cell.append(box, subEl);
        return cell;
    }

    function render(rows: Row[], saidCount = 0) {
        board.replaceChildren();
        const graphemes = Array.from(currentWord);
        graphemes.forEach((grapheme, i) => {
            const row: Row | undefined = rows[i];
            let cls = '';
            let sub = '';
            if (row && row.ok) {
                cls = 'ok';
            } else if (row && row.said !== null) {
                cls = 'bad';
                sub = `${row.said} ≠ ${row.letter}`;
            } else if (row && i < saidCount) {
                // A token was given for this position but not recognized.
                cls = 'bad';
                sub = '?';
            }
            if (answerShown && cls !== 'bad') {
                sub = answers.get(normalize(grapheme)) ?? '';
            }
            board.append(makeTile(grapheme, cls, sub));
        });
        for (const row of rows.filter((r) => r.extra)) {
            board.append(makeTile('+', 'bad extra', row.said ?? '?'));
        }
    }

    function pickWord(): string {
        const list = wordList();
        let word = list[Math.floor(Math.random() * list.length)];
        while (list.length > 1 && word === previousWord) {
            word = list[Math.floor(Math.random() * list.length)];
        }
        return word;
    }

    let advanceTimer: ReturnType<typeof setTimeout> | undefined;

    function loadWord() {
        clearTimeout(advanceTimer);
        previousWord = currentWord;
        currentWord = pickWord();
        answerShown = false;
        wordSolved = false;
        board.classList.remove('solved');
        input.value = '';
        hint.textContent = DEFAULT_HINT;
        render([]);
    }

    function onLiveInput() {
        if (wordSolved) return; // keep the celebration on screen until the next word
        const decoded = liveDecode(input.value, index);
        render(check(currentWord, decoded), decoded.length);
    }

    // A solved word celebrates (the tiles pop one after another), then the next
    // word follows. After speech it stays a little longer, so what was heard
    // can be read.
    const ADVANCE_MS = {typed: 1_400, spoken: 2_500};

    function celebrate(rows: Row[], heard: string | null) {
        render(rows);
        board.querySelectorAll<HTMLElement>('.cell').forEach((cell, i) => cell.style.setProperty('--i', String(i)));
        board.classList.add('solved');
        hint.textContent = heard ? `Solved! Heard “${heard}”.` : 'Solved!';
        advanceTimer = setTimeout(() => {
            loadWord();
            hint.textContent = 'Here is the next word.';
        }, heard ? ADVANCE_MS.spoken : ADVANCE_MS.typed);
    }

    function runCheck(fromSpeech = false) {
        if (wordSolved) return;
        const tokens = tokenize(input.value);
        if (tokens.length === 0) return;
        const decoded = decode(tokens, index);
        const rows = check(currentWord, decoded);
        if (isComplete(rows)) {
            wordSolved = true;
            celebrate(rows, fromSpeech ? input.value.trim() : null);
        } else {
            render(rows, decoded.length);
            hint.textContent = 'Not quite — fix the red tiles, or show the answer.';
        }
    }

    // --- reference table ---

    function buildReference() {
        refTitle.textContent = MODE_LABELS[mode];
        // Two columns of letter + code word, so the whole alphabet fits on screen.
        // The official word first; accepted variants (Alpha, Caesar) quieter below.
        const list = document.createElement('dl');
        list.className = 'ref-list';
        for (const [letters, [primary, ...variants]] of Object.entries(modeTables[mode][0])) {
            const item = document.createElement('div');
            const term = document.createElement('dt');
            term.textContent = displayLetter(letters);
            const word = document.createElement('dd');
            word.textContent = primary;
            if (variants.length > 0) {
                const alt = document.createElement('small');
                alt.textContent = variants.join(', ');
                word.append(alt);
            }
            item.append(term, word);
            list.append(item);
        }
        refBody.replaceChildren(list);
        if (mode === 'de') {
            const note = document.createElement('p');
            note.className = 'ref-note';
            note.textContent = 'ch and sch have no code words in this table — they are spelled letter by letter.';
            refBody.append(note);
        }
    }

    // --- speech input ---

    let listening = false;
    let suppressFinalCheck = false;

    function updateMicUi() {
        micButton.classList.toggle('listening', listening);
        micButton.setAttribute('aria-pressed', String(listening));
        micButton.setAttribute('aria-label', listening ? 'Stop speech input' : 'Speech input');
    }

    function stopListening(runFinalCheck: boolean) {
        suppressFinalCheck = !runFinalCheck;
        stopLive?.();
    }

    const SPEECH_ERRORS: Record<string, string> = {
        'not-allowed': 'Microphone access was denied — allow the microphone for this site and try again.',
        'no-speech': 'Didn’t hear anything — press the mic again and speak the code words clearly.',
    };

    let starting = false;

    // --- streamed speech input ---

    // The site's own token service (services/speech) hands out single-use tokens;
    // the audio goes straight to Google. In development `npm run speech` runs the
    // service, and the dev server passes /api on to it (astro.config.mjs).
    const TOKEN_URL = '/api/live-token';
    const LIVE_URL = 'wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained';
    const LIVE_MODEL = 'models/gemini-3.5-transcribe-live';
    const FINAL_TIMEOUT_MS = 3_000;
    // Generous, so slow learners can take their time.
    const MAX_RECORDING_MS = 30_000;
    // Recording stops by itself once the speaker has been quiet this long.
    // Generous, so a pause between two code words doesn't cut anyone off.
    const PAUSE_MS = 2_000;
    const LISTENING_HINT = 'Listening — say the code words. Recording stops by itself after a short pause.';

    // Listens to the microphone level: feeds the level meter, and calls onPause
    // once someone has spoken and then been quiet for PAUSE_MS.
    // "Quiet" is relative to the room: the background level is the 10th
    // percentile of the last 8 s, so steady noise (traffic, a fan) is ignored.
    // If speech never stands out from the noise, onPause never fires and the
    // recording runs until the user clicks or MAX_RECORDING_MS.
    function watchMic(stream: MediaStream, onPause?: () => void): {stop(): void} {
        const ctx = new AudioContext();
        void ctx.resume();
        const analyser = ctx.createAnalyser();
        analyser.fftSize = 1024;
        ctx.createMediaStreamSource(stream).connect(analyser);
        const samples = new Float32Array(analyser.fftSize);
        const FRAME_MS = 50;
        const history: number[] = [];
        let loudFrames = 0;
        let hasSpoken = false;
        let lastVoiceAt = Date.now();

        const timer = setInterval(() => {
            analyser.getFloatTimeDomainData(samples);
            let sum = 0;
            for (const s of samples) sum += s * s;
            const level = 10 * Math.log10(sum / samples.length + 1e-10); // dB

            history.push(level);
            if (history.length > 8000 / FRAME_MS) history.shift();
            const background = [...history].sort((a, b) => a - b)[Math.floor(history.length * 0.1)];
            pushLevel((level - background - 3) / 30);

            if (level > background + 12) {
                loudFrames += 1;
                if (loudFrames >= 4) hasSpoken = true; // 200 ms of clear speech
            } else {
                loudFrames = 0;
            }
            if (level > background + 6) lastVoiceAt = Date.now();
            if (onPause && hasSpoken && Date.now() - lastVoiceAt >= PAUSE_MS) onPause();
        }, FRAME_MS);

        return {
            stop() {
                clearInterval(timer);
                void ctx.close();
            },
        };
    }

    // --- level meter: thin bars, newest on the right, like a voice memo ---

    const METER_BARS = 28;
    const meterLevels: number[] = [];

    function resetMeter() {
        meterLevels.length = 0;
        levelMeter.replaceChildren(...Array.from({length: METER_BARS}, () => document.createElement('span')));
        renderMeter();
    }

    function pushLevel(level: number) {
        meterLevels.push(Math.max(0, Math.min(1, level)));
        if (meterLevels.length > METER_BARS) meterLevels.shift();
        renderMeter();
    }

    function renderMeter() {
        const bars = levelMeter.children;
        const offset = METER_BARS - meterLevels.length;
        for (let i = 0; i < bars.length; i++) {
            const level = i >= offset ? meterLevels[i - offset] : 0;
            (bars[i] as HTMLElement).style.transform = `scaleY(${0.15 + level * 0.85})`;
        }
    }

    // --- microphone choice ---

    function chosenMic(): MediaTrackConstraints | true {
        const id = storage.get('mic');
        return id ? {deviceId: {ideal: id}} : true;
    }

    async function openMic(): Promise<MediaStream> {
        return navigator.mediaDevices.getUserMedia({audio: chosenMic()});
    }

    // Lists the microphones once the page may see their names (after the first
    // permission grant); hidden while there is only one.
    // The choice shows only while recording, next to the level meter — where
    // you notice that the wrong mic is listening.
    let hasMicChoice = false;
    let recordingShown = false;
    let restartAfterStop = false;

    async function refreshMicChoice() {
        if (!navigator.mediaDevices?.enumerateDevices) return;
        const mics = (await navigator.mediaDevices.enumerateDevices())
            .filter((device) => device.kind === 'audioinput' && device.deviceId !== 'default' && device.deviceId !== 'communications');
        hasMicChoice = mics.length > 1 && mics.every((mic) => mic.label !== '');
        micChoice.hidden = !(hasMicChoice && recordingShown);
        if (!hasMicChoice) return;
        const saved = storage.get('mic') ?? '';
        micSelect.replaceChildren(
            new Option('System default', ''),
            ...mics.map((mic) => new Option(mic.label, mic.deviceId)),
        );
        micSelect.value = mics.some((mic) => mic.deviceId === saved) ? saved : '';
    }

    // Switching mics mid-recording starts over with the new one.
    micSelect.addEventListener('change', () => {
        storage.set('mic', micSelect.value);
        if (listening) {
            restartAfterStop = true;
            stopListening(false);
        }
    });

    function restartIfRequested() {
        if (!restartAfterStop) return;
        restartAfterStop = false;
        void startRecording();
    }
    navigator.mediaDevices?.addEventListener?.('devicechange', () => void refreshMicChoice());
    void refreshMicChoice();
    let stopLive: (() => void) | null = null;
    let cloudNoticeShown = false;

    // Shown once before the first streamed recording; pressing the mic again is
    // the consent. What it says has to match /datenschutz/.
    function showCloudNotice() {
        const link = document.createElement('a');
        link.href = '/datenschutz/#spracheingabe';
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = 'privacy policy';
        hint.replaceChildren(
            'To use the mic, what you say is streamed to Google for transcription. This site stores nothing; Google may keep it for up to 55 days to detect abuse. Adults (18+) only. Details are in the ',
            link,
            ' (German). Press the mic again to agree and start.',
        );
    }

    // The row under the hint: an indeterminate bar while something loads or
    // transcribes, or the level meter and a timer while recording.
    function showProgress(label: string) {
        modelProgress.setAttribute('aria-label', label);
        modelProgress.removeAttribute('value');
        modelProgress.hidden = false;
        levelMeter.hidden = true;
        recordingShown = false;
        micChoice.hidden = true;
        modelElapsed.textContent = '';
        modelDownload.hidden = false;
    }

    // Shows the level meter, a running timer and the mic choice; returns a
    // function that stops the timer.
    function showRecording(): () => void {
        resetMeter();
        levelMeter.hidden = false;
        modelProgress.hidden = true;
        recordingShown = true;
        micChoice.hidden = !hasMicChoice;
        modelDownload.hidden = false;
        const startedAt = Date.now();
        const tick = () => {
            modelElapsed.textContent = `${formatSeconds(Date.now() - startedAt)} / ${formatSeconds(MAX_RECORDING_MS)}`;
        };
        tick();
        const timer = setInterval(tick, 250);
        return () => clearInterval(timer);
    }

    function hideProgress() {
        recordingShown = false;
        modelDownload.hidden = true;
    }

    function formatSeconds(ms: number): string {
        const s = Math.floor(ms / 1000);
        return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    }

    // The code words, plus the doubling prefix ("Doppel-Samuel"), so the
    // transcription spells them the way the trainer expects.
    function vocabulary(): string[] {
        const codeWords = modeTables[mode].flatMap((table) => Object.values(table).flat());
        return [...new Set([...codeWords, mode === 'nato' ? 'double' : 'Doppel'])];
    }

    // --- live transcription: stream the mic to Gemini and show words as they come ---

    // Captures the microphone as 16 kHz 16-bit mono PCM in ~100 ms chunks, the
    // format the live model takes. Runs at the device's own sample rate and
    // downsamples here, since not every browser lets a 16 kHz context read a mic.
    const CAPTURE_WORKLET = `
        registerProcessor('pcm-capture', class extends AudioWorkletProcessor {
            process(inputs) {
                const channel = inputs[0][0];
                if (channel) this.port.postMessage(channel.slice(0));
                return true;
            }
        });`;
    const TARGET_RATE = 16_000;
    const CHUNK_SAMPLES = TARGET_RATE / 10;

    async function capturePcm(stream: MediaStream, onChunk: (pcm: Int16Array) => void): Promise<() => void> {
        const ctx = new AudioContext();
        const moduleUrl = URL.createObjectURL(new Blob([CAPTURE_WORKLET], {type: 'text/javascript'}));
        try {
            await ctx.audioWorklet.addModule(moduleUrl);
        } finally {
            URL.revokeObjectURL(moduleUrl);
        }
        const source = ctx.createMediaStreamSource(stream);
        const worklet = new AudioWorkletNode(ctx, 'pcm-capture');
        const mute = ctx.createGain();
        mute.gain.value = 0;
        source.connect(worklet).connect(mute).connect(ctx.destination); // keeps the worklet running

        // Each output sample is the average of the input samples it covers
        // (a box filter), which keeps aliasing down without a real resampler.
        const step = ctx.sampleRate / TARGET_RATE;
        let position = 0;
        let chunk = new Int16Array(CHUNK_SAMPLES);
        let filled = 0;
        worklet.port.onmessage = (event: MessageEvent<Float32Array>) => {
            const samples = event.data;
            while (position + step <= samples.length) {
                let sum = 0;
                const from = Math.floor(position);
                const to = Math.floor(position + step);
                for (let i = from; i < to; i++) sum += samples[i];
                const value = sum / Math.max(1, to - from);
                chunk[filled++] = Math.max(-1, Math.min(1, value)) * 0x7fff;
                if (filled === CHUNK_SAMPLES) {
                    onChunk(chunk);
                    chunk = new Int16Array(CHUNK_SAMPLES);
                    filled = 0;
                }
                position += step;
            }
            position -= samples.length;
        };
        await ctx.resume();

        return () => {
            if (filled > 0) onChunk(chunk.slice(0, filled));
            worklet.port.onmessage = null;
            source.disconnect();
            void ctx.close();
        };
    }

    function base64(pcm: Int16Array): string {
        const bytes = new Uint8Array(pcm.buffer, pcm.byteOffset, pcm.byteLength);
        let binary = '';
        for (let i = 0; i < bytes.length; i += 0x8000) binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
        return btoa(binary);
    }

    interface LiveSession {
        send(pcm: Int16Array): void;
        /** Ends the audio and resolves with the final transcript. */
        finish(): Promise<string>;
        close(): void;
    }

    // One session per recording. Audio captured while the token and socket are
    // still being set up is queued and sent once the model is ready, so
    // nothing said right after pressing the mic is lost.
    function openLiveSession(lang: string, onText: (text: string) => void, onError: (message: string) => void): LiveSession {
        const queue: string[] = [];
        let socket: WebSocket | null = null;
        let ready = false;
        let ended = false;
        let closed = false;
        let committed = '';
        let interim = '';
        let resolveFinal: ((text: string) => void) | null = null;
        const transcript = () => [committed, interim].filter(Boolean).join(' ');

        const fail = (message: string) => {
            if (closed) return;
            closed = true;
            socket?.close();
            if (resolveFinal) resolveFinal(transcript());
            else onError(message);
        };
        const sendAudioEnd = () => socket?.send(JSON.stringify({realtimeInput: {audioStreamEnd: true}}));

        void (async () => {
            let token: string;
            try {
                const response = await fetch(TOKEN_URL, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({lang, vocabulary: vocabulary()}),
                });
                if (response.status === 429) return fail('Too many attempts — wait a minute, then try again.');
                if (!response.ok) return fail('The speech service is unavailable right now — type the code words instead.');
                token = (await response.json()).token;
            } catch {
                return fail('The speech service could not be reached — check your connection, or type the code words.');
            }
            if (closed) return;

            socket = new WebSocket(`${LIVE_URL}?access_token=${encodeURIComponent(token)}`);
            socket.onopen = () => socket?.send(JSON.stringify({setup: {model: LIVE_MODEL}})); // the rest is locked in the token
            socket.onerror = () => fail('The speech service could not be reached — check your connection, or type the code words.');
            socket.onclose = () => {
                if (!closed) fail('The speech service closed the connection — try again, or type the code words.');
            };
            socket.onmessage = async (event) => {
                const message = JSON.parse(typeof event.data === 'string' ? event.data : await event.data.text());
                if (message.setupComplete) {
                    ready = true;
                    for (const data of queue.splice(0)) socket?.send(data);
                    if (ended) sendAudioEnd();
                    return;
                }
                const content = message.serverContent;
                if (content?.interimInputTranscription) {
                    interim = String(content.interimInputTranscription.text ?? '').trim();
                    onText(transcript());
                }
                if (content?.inputTranscription) {
                    committed = [committed, String(content.inputTranscription.text ?? '').trim()].filter(Boolean).join(' ');
                    interim = '';
                    onText(transcript());
                }
                if (ended && resolveFinal && (content?.inputTranscription || content?.generationComplete || content?.turnComplete)) {
                    resolveFinal(transcript());
                }
            };
        })();

        return {
            send(pcm) {
                if (closed || ended) return;
                const data = JSON.stringify({realtimeInput: {audio: {data: base64(pcm), mimeType: `audio/pcm;rate=${TARGET_RATE}`}}});
                if (ready) socket?.send(data);
                else queue.push(data);
            },
            finish() {
                return new Promise((resolve) => {
                    const done = (text: string) => {
                        resolveFinal = null;
                        clearTimeout(timeout);
                        this.close();
                        resolve(text);
                    };
                    // Gemini finalises each phrase on its own shortly after the
                    // speaker stops, so after our pause the text is usually final
                    // already. Otherwise the rest comes within half a second.
                    const timeout = setTimeout(() => done(transcript()), FINAL_TIMEOUT_MS);
                    resolveFinal = done;
                    ended = true;
                    if (closed || (committed && !interim)) done(transcript());
                    else if (ready) sendAudioEnd();
                });
            },
            close() {
                closed = true;
                socket?.close();
            },
        };
    }

    // Does the text spoken so far already spell the whole word? Then there's
    // no need to wait for the pause.
    function spellsCurrentWord(text: string): boolean {
        return isComplete(check(currentWord, decode(tokenize(text), index)));
    }

    async function startRecording() {
        if (stopLive || starting) return;
        if (storage.get('cloud-speech') !== 'ok') {
            if (!cloudNoticeShown) {
                cloudNoticeShown = true;
                showCloudNotice();
                return;
            }
            storage.set('cloud-speech', 'ok');
        }
        if (!navigator.mediaDevices?.getUserMedia || typeof AudioWorkletNode === 'undefined' || typeof WebSocket === 'undefined') {
            hint.textContent = 'This browser can’t stream audio — type the code words instead.';
            return;
        }
        starting = true;
        let stream: MediaStream;
        try {
            stream = await openMic();
        } catch {
            starting = false;
            hint.textContent = SPEECH_ERRORS['not-allowed'];
            return;
        }
        void refreshMicChoice(); // names are visible now that access was granted

        const lang = speechLang();
        input.value = ''; // a new recording replaces the previous attempt
        onLiveInput();
        suppressFinalCheck = false;

        // Declared first: the session can report text or errors while the
        // capture below is still starting.
        let finished = false;
        let finish: (() => Promise<void>) | null = null;
        let failure: string | null = null;
        const failWith = (message: string) => {
            failure = message;
            if (!finish || finished) return; // handled once the capture has started
            suppressFinalCheck = true;
            void finish();
            hint.textContent = message;
        };

        const session = openLiveSession(
            lang,
            (text) => {
                if (finished || lang !== speechLang()) return;
                input.value = text;
                onLiveInput();
                if (spellsCurrentWord(text)) stopListening(true);
            },
            failWith,
        );
        let stopCapture: () => void;
        try {
            stopCapture = await capturePcm(stream, (pcm) => session.send(pcm));
        } catch {
            starting = false;
            session.close();
            stream.getTracks().forEach((track) => track.stop());
            hint.textContent = 'This browser can’t stream audio — type the code words instead.';
            return;
        }
        starting = false;
        const cutoff = setTimeout(() => stopListening(true), MAX_RECORDING_MS);
        const stopTimer = showRecording();
        const mic = watchMic(stream, () => stopListening(true));

        finish = async () => {
            if (finished) return;
            finished = true;
            clearTimeout(cutoff);
            stopTimer();
            mic.stop();
            stopCapture();
            stream.getTracks().forEach((track) => track.stop());
            listening = false;
            updateMicUi();
            if (suppressFinalCheck) {
                session.close();
                hideProgress();
                stopLive = null;
                restartIfRequested();
                return;
            }
            micButton.disabled = true;
            showProgress('Finishing transcription');
            try {
                const text = await session.finish();
                if (lang !== speechLang()) return; // mode changed meanwhile
                input.value = text;
                onLiveInput();
                if (tokenize(text).length > 0) {
                    runCheck(true);
                } else {
                    hint.textContent = SPEECH_ERRORS['no-speech'];
                }
            } finally {
                hideProgress();
                stopLive = null;
                micButton.disabled = false;
            }
        };
        stopLive = () => void finish?.();

        listening = true;
        updateMicUi();
        hint.textContent = LISTENING_HINT;
        if (failure) failWith(failure); // the session failed while the capture was starting
    }

    function speechLang(): string {
        return mode === 'nato' ? 'en-US' : 'de-DE';
    }

    micButton.addEventListener('click', () => {
        if (listening) {
            stopListening(true);
        } else {
            void startRecording();
        }
    });

    // --- wiring ---

    function applyMode(next: Mode) {
        mode = next;
        storage.set('mode', mode);
        index = buildIndex(modeTables[mode]);
        answers = primaryAliases(modeTables[mode]);
        if (listening) stopListening(false);
        buildReference();
        previousWord = '';
        loadWord();
    }

    for (const radio of modeInputs) {
        radio.checked = radio.value === mode;
        radio.addEventListener('change', () => {
            if (radio.checked) applyMode(radio.value as Mode);
        });
    }

    function submitCheck() {
        if (listening) stopListening(false);
        runCheck();
    }

    form.addEventListener('submit', (event) => {
        event.preventDefault();
        submitCheck();
    });

    input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            event.preventDefault();
            submitCheck();
        }
    });

    input.addEventListener('input', onLiveInput);

    newWordButton.addEventListener('click', () => {
        if (listening) stopListening(false);
        loadWord();
        input.focus();
    });

    showAnswerButton.addEventListener('click', () => {
        answerShown = true;
        onLiveInput();
    });

    // --- reference panel ---

    function setReferenceOpen(open: boolean, remember = true) {
        refPanel.hidden = !open;
        document.body.classList.toggle('ref-open', open);
        refToggle.setAttribute('aria-expanded', String(open));
        refToggle.textContent = open ? 'Hide alphabet' : 'Show alphabet';
        if (remember) storage.set('reference', open ? 'open' : 'closed');
    }

    refToggle.addEventListener('click', () => setReferenceOpen(refPanel.hidden));
    refClose.addEventListener('click', () => {
        setReferenceOpen(false);
        refToggle.focus();
    });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !refPanel.hidden && refPanel.contains(document.activeElement)) {
            setReferenceOpen(false);
            refToggle.focus();
        }
    });

    buildReference();
    // Reopen it only where it sits beside the trainer; on phones it would cover it.
    setReferenceOpen(storage.get('reference') === 'open' && matchMedia('(min-width: 60rem)').matches, false);
    loadWord();
</script>

