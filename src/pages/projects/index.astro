---
import {getCollection} from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const order = ['secretli', 'chatpulse', 'agesharp', 'pqsign', 'uuid', 'k8s-cluster'];
const allProjects = await getCollection('projects');
const projects = order.map((id) => allProjects.find((p) => p.id === id)!).filter(Boolean);

const groups = [
    {label: 'Live apps', kinds: ['Live']},
    {label: 'Libraries and tools', kinds: ['Library', 'CLI']},
    {label: 'Infrastructure', kinds: ['Infrastructure']},
].map((g) => ({...g, items: projects.filter((p) => g.kinds.includes(p.data.kind))}))
 .filter((g) => g.items.length > 0);
---

<Layout
    title="Projects - Patrick Scheid"
    description="Open-source projects by Patrick Scheid — libraries, tools, and applications in Go, C#, and TypeScript."
    pageClass="site page-projects"
>
    <header class="grid page-head">
        <h1>Projects</h1>
        <p class="page-dek">
            A selection of open-source tools and libraries I've built — from cryptography and security to
            real-time systems and developer utilities.
        </p>
    </header>

    {groups.map((group) => (
        <section class="grid section">
            <h2 class="index label">{group.label}</h2>
            <ul class="ledger">
                {group.items.map((project) => (
                    <li>
                        <a class="ledger-title" href={`/projects/${project.id}/`}>{project.data.title}</a>
                        <p class="ledger-text">{project.data.description}</p>
                        <p class="ledger-meta">
                            {[project.data.language, project.data.secondaryLanguage].filter(Boolean).join(', ')}
                            {project.data.github && <> &middot; <a href={project.data.github}>Source</a></>}
                            {project.data.liveUrl && <> &middot; <a href={project.data.liveUrl}>Open app</a></>}
                        </p>
                    </li>
                ))}
            </ul>
        </section>
    ))}
</Layout>

<style>
    .page-head h1 {
        font-size: 2.5rem;
        letter-spacing: -0.02em;
        margin: 0 0 0.4rem;
    }

    .page-dek {
        font-family: var(--font-text);
        font-size: 1.2rem;
        color: var(--color-text-muted);
        margin: 0;
    }

    @media (max-width: 720px) {
        .page-head h1 {
            font-size: 2rem;
        }
    }
</style>
