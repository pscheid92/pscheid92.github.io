---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Page not found - Patrick Scheid"
    description="This page doesn't exist, or it has been removed."
    pageClass="site page-404"
>
    <section class="grid">
        <p class="index label">404</p>
        <div>
            <h1>Page not found</h1>
            <p class="page-dek">This page doesn’t exist, or it has been removed.</p>
            <ul class="ledger compact next">
                <li><a class="ledger-title" href="/">Home</a></li>
                <li><a class="ledger-title" href="/blog/">Writing</a></li>
                <li><a class="ledger-title" href="/projects/">Projects</a></li>
                <li><a class="ledger-title" href="/pages/">Tools and pages</a></li>
            </ul>
        </div>
    </section>
</Layout>

<style>
    h1 {
        font-size: 2.5rem;
        letter-spacing: -0.02em;
        margin: 0 0 0.4rem;
    }

    .page-dek {
        font-family: var(--font-text);
        font-size: 1.2rem;
        color: var(--color-text-muted);
        margin: 0 0 2rem;
    }

    .label {
        padding-top: 0.9rem;
    }
</style>
