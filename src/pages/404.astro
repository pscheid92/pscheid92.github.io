---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Page not found - Patrick Scheid"
    description="This page doesn't exist, or it has been removed."
    pageClass="page-404"
>
    <section class="notfound-shell" aria-labelledby="notfound-title">
        <p class="eyebrow">404</p>
        <h1 id="notfound-title">Page not found</h1>
        <p class="tagline">This page doesn’t exist, or it has been removed.</p>

        <nav class="links" aria-label="Where to go next">
            <a href="/">Home</a>
            <a href="/blog/">Blog</a>
            <a href="/projects/">Projects</a>
            <a href="/pages/">Tools &amp; pages</a>
        </nav>
    </section>
</Layout>

<style>
    .notfound-shell {
        max-width: 36rem;
        margin: 0 auto;
        padding: 4rem 0 3rem;
        text-align: center;
    }

    .eyebrow {
        margin: 0 0 0.35rem;
        color: var(--color-accent);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    h1 {
        margin-bottom: 0.4rem;
    }

    .tagline {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 1.1rem;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.8rem;
        margin-top: 2rem;
    }

    .links a {
        font: 600 0.85rem/1.3 'Atkinson', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-text-heading);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 0.65rem 1.3rem;
    }

    .links a:hover {
        border-color: var(--color-text-muted);
        color: var(--color-text-heading);
    }
</style>
