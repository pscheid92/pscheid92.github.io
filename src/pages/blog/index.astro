---
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
import {getVisiblePosts, readTime, toEntries} from '../../lib/writing';

// One list with each date in the margin: reads as a whole with three posts and still scales to fifty
const entries = toEntries(await getVisiblePosts());
---

<Layout title="Writing - Patrick Scheid" description="Articles and insights on engineering management, software development, team leadership, and AI product development by Patrick Scheid." pageClass="site page-blog">
    <header class="grid page-head">
        <h1>Writing</h1>
        <p class="page-dek">Thoughts on engineering, infrastructure, AI, and leadership.</p>
    </header>

    <ul class="writing-list">
        {entries.map((entry) => entry.kind === 'series' ? (
            <li class="grid row" id={`series-${entry.id}`}>
                <p class="index row-date"><FormattedDate date={entry.date}/></p>
                <div>
                    <span class="ledger-title">{entry.title}</span>
                    <span class="series-tag">Series &middot; {entry.parts.length} parts</span>
                    <p class="ledger-text">{entry.description}</p>
                    <ol class="series-parts">
                        {entry.parts.map((p) => (
                            <li><a href={`/blog/${p.id}/`}>{p.data.title}</a> <span class="ledger-meta">{readTime(p)} min</span></li>
                        ))}
                    </ol>
                </div>
            </li>
        ) : (
            <li class="grid row">
                <p class="index row-date"><FormattedDate date={entry.date}/></p>
                <div>
                    <a class="ledger-title" href={`/blog/${entry.post.id}/`}>{entry.post.data.title}</a>
                    <p class="ledger-text">{entry.post.data.description}</p>
                    <p class="ledger-meta">
                        {readTime(entry.post)} min read
                        {entry.post.data.tags.length > 0 && <>&middot; {entry.post.data.tags.join(', ')}</>}
                    </p>
                </div>
            </li>
        ))}
    </ul>
</Layout>

<style>
    .page-head h1 {
        font-size: 2.5rem;
        letter-spacing: -0.02em;
        margin: 0 0 0.4rem;
    }

    .page-dek {
        font-family: var(--font-text);
        font-size: 1.2rem;
        color: var(--color-text-muted);
        margin: 0;
    }

    .writing-list {
        list-style: none;
        margin: 2.5rem 0 0;
        padding: 0;
    }

    .row {
        padding: 1.25rem 0;
        border-top: 1px solid var(--color-border);
    }

    .row-date {
        margin: 0;
        padding-top: 0.1rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
        font-variant-numeric: tabular-nums;
    }

    .series-tag {
        margin-left: 0.6rem;
        font-size: 0.85rem;
        color: var(--color-text-muted);
    }

    .series-parts {
        margin: 0.6rem 0 0.2rem;
        padding-left: 1.5em;
        font-size: 0.95rem;
    }

    .series-parts li {
        padding: 0.15rem 0 0.15rem 0.25em;
    }

    .series-parts li::marker {
        color: var(--color-text-muted);
        font-variant-numeric: tabular-nums;
    }

    .series-parts .ledger-meta {
        margin-left: 0.35rem;
        font-size: 0.8rem;
    }

    @media (max-width: 63.99rem) {
        .row-date {
            margin-bottom: 0.3rem;
        }
    }

    @media (max-width: 720px) {
        .page-head h1 {
            font-size: 2rem;
        }
    }
</style>
