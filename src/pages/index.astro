---
import {Image} from 'astro:assets';
import Avatar from '../assets/avatar.webp';
import Layout from '../layouts/Layout.astro';
import {getPublishedPosts, toEntries} from '../lib/writing';

// One pointer to the newest writing keeps the page current without turning it into an index
const [latest] = toEntries(await getPublishedPosts());
---

<Layout
    title="Patrick Scheid - Engineering Manager"
    description="Engineering Manager at STACKIT, leading the Identity and Access Management team. Writing about cryptography, Kubernetes, and engineering leadership."
    pageClass="site page-home"
>
    <section class="intro">
        <Image src={Avatar} alt="Portrait of Patrick Scheid" class="avatar" width={224} height={224} loading="eager" fetchpriority="high"/>
        <h1>Hi, I'm Patrick.</h1>
        <p class="lede">
            Engineering manager at STACKIT in Bad Friedrichshall, leading the Identity and Access Management team,
            with 10+ years of building and scaling backend systems.
        </p>
        {latest && (
            <p class="latest">
                <span class="label">Latest writing</span>
                {latest.kind === 'series' ? (
                    <a href={`/blog/#series-${latest.id}`}>{latest.title}, a {latest.parts.length}-part series&nbsp;&rarr;</a>
                ) : (
                    <a href={`/blog/${latest.post.id}/`}>{latest.post.data.title}&nbsp;&rarr;</a>
                )}
            </p>
        )}
        <p class="more"><a href="/about/">More about me&nbsp;&rarr;</a></p>
    </section>
</Layout>

<style>
    /* The landing page is a single centred block; there is too little on it for the page grid to read as intended */
    :global(body.page-home main) {
        display: grid;
        align-content: center;
    }

    .intro {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: 36rem;
        margin-inline: auto;
        text-align: center;
    }

    .avatar {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        margin-bottom: 1.75rem;
    }

    h1 {
        font-size: 2.75rem;
        line-height: 1.1;
        margin: 0 0 1rem;
        letter-spacing: -0.02em;
    }

    .lede {
        font-family: var(--font-text);
        font-size: 1.35rem;
        line-height: 1.5;
        margin: 0;
        text-wrap: balance;
    }

    .latest {
        margin: 2.5rem 0 0;
    }

    .latest .label {
        display: block;
        margin-bottom: 0.15rem;
    }

    .latest a {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--color-text-heading);
    }

    .latest a:hover {
        color: var(--color-accent);
    }

    .more {
        margin: 1.5rem 0 0;
        font-weight: 700;
        font-size: 0.95rem;
    }

    @media (max-width: 63.99rem) {
        .avatar {
            width: 88px;
            height: 88px;
            margin-bottom: 1.25rem;
        }

        h1 {
            font-size: 2.1rem;
        }

        .lede {
            font-size: 1.2rem;
        }
    }
</style>
