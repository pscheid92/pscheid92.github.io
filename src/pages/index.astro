---
import {Image} from 'astro:assets';
import {getCollection} from 'astro:content';
import Avatar from '../assets/avatar.webp';
import FormattedDate from '../components/FormattedDate.astro';
import Layout from '../layouts/Layout.astro';
import {getPublishedPosts, toEntries} from '../lib/writing';

const entries = toEntries(await getPublishedPosts()).slice(0, 4);

const allProjects = await getCollection('projects');
const projects = ['secretli', 'pqsign', 'agesharp', 'chatpulse']
    .map((id) => allProjects.find((p) => p.id === id)!)
    .filter(Boolean);

const focus = [
    ['AI / ML', 'Integrating LLM research into production editing tools serving 500k+ daily users at DeepL.'],
    ['Backend engineering', 'Scalable systems in C#, Kotlin, and Go; operated ~60 microservices on Kubernetes/AWS.'],
    ['Data engineering', 'End-to-end data pipelines, ETL design, and validation pipelines for ML systems.'],
    ['Product ownership', 'Turned a platform API into an API-as-a-Product at Ryte.'],
    ['Engineering management', 'Led teams of up to 8 engineers at DeepL: hiring, mentoring, reorgs.'],
];
---

<Layout
    title="Patrick Scheid - Senior Software Engineer"
    description="Senior Software Engineer at DeepL in Munich. Combining software engineering, data science, product management, and engineering leadership to build AI-powered products."
    pageClass="site page-home"
>
    <section class="grid intro">
        <div class="index">
            <Image src={Avatar} alt="Portrait of Patrick Scheid" class="avatar" width={192} height={192} loading="eager" fetchpriority="high"/>
        </div>
        <div>
            <h1>Hi, I'm Patrick.</h1>
            <p class="lede">
                Senior software engineer with 9+ years of experience building and scaling backend systems, combined
                with 2+ years of engineering management. I bridge deep hands-on engineering in C#, Kotlin, and Go
                with a strong understanding of team dynamics, system design trade-offs, and cross-functional alignment.
            </p>
            <p class="role">Senior Software Engineer at DeepL &middot; Munich &middot; <a href="/about/">More about me</a></p>
        </div>
    </section>

    <section class="grid section">
        <h2 class="index label">Writing</h2>
        <div>
            <ul class="ledger compact">
                {entries.map((entry) => entry.kind === 'series' ? (
                    <li>
                        <a class="ledger-title" href={`/blog/#series-${entry.id}`}>{entry.title}</a>
                        <span class="ledger-meta">Series &middot; {entry.parts.length} parts</span>
                        <p class="ledger-text">{entry.description}</p>
                    </li>
                ) : (
                    <li>
                        <a class="ledger-title" href={`/blog/${entry.post.id}/`}>{entry.post.data.title}</a>
                        <span class="ledger-meta"><FormattedDate date={entry.date}/></span>
                    </li>
                ))}
            </ul>
            <a class="more-link" href="/blog/">All writing &rarr;</a>
        </div>
    </section>

    <section class="grid section">
        <h2 class="index label">Projects</h2>
        <div>
            <ul class="ledger compact">
                {projects.map((project) => (
                    <li>
                        <a class="ledger-title" href={`/projects/${project.id}/`}>{project.data.title}</a>
                        <span class="ledger-meta">{[project.data.kind, project.data.language, project.data.secondaryLanguage].filter(Boolean).join(' · ')}</span>
                        <p class="ledger-text">{project.data.summary}</p>
                    </li>
                ))}
            </ul>
            <a class="more-link" href="/projects/">All projects &rarr;</a>
        </div>
    </section>

    <section class="grid section">
        <h2 class="index label">What I bring</h2>
        <ul class="ledger compact">
            {focus.map(([term, text]) => (
                <li>
                    <span class="ledger-title">{term}</span>
                    <p class="ledger-text">{text}</p>
                </li>
            ))}
        </ul>
    </section>
</Layout>

<style>
    .intro {
        align-items: start;
    }

    .avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        display: block;
    }

    h1 {
        font-size: 2.5rem;
        line-height: 1.1;
        margin: 0 0 1rem;
        letter-spacing: -0.02em;
    }

    .lede {
        font-family: var(--font-text);
        font-size: 1.3rem;
        line-height: 1.55;
        margin: 0 0 1rem;
        text-wrap: pretty;
    }

    .role {
        margin: 0;
        font-size: 0.95rem;
        color: var(--color-text-muted);
    }


    @media (max-width: 63.99rem) {
        .avatar {
            width: 72px;
            height: 72px;
            margin-bottom: 1.25rem;
        }

        h1 {
            font-size: 2rem;
        }

        .lede {
            font-size: 1.15rem;
        }
    }
</style>
