---
import Layout from '../layouts/Layout.astro';

const pages = [
    {
        href: '/cpr-trainer/',
        title: 'CPR Rhythm Trainer',
        tag: 'Training tool',
        description: 'Learn the chest compression rhythm: listen to 110 per minute, tap along, count to 30, take the 2-minute test.',
    },
    {
        href: '/spelling-trainer/',
        title: 'Spelling Alphabet Trainer',
        tag: 'Training tool',
        description: 'Spell random words with the NATO alphabet, the German Buchstabiertafel or the BOS table — by keyboard or voice, with per-letter feedback.',
    },
    {
        href: '/bmi/',
        title: 'BMI Calculator',
        tag: 'Calculator',
        description: 'Standard and Oxford (Trefethen) Body Mass Index, side by side.',
    },
    {
        href: '/blood-volume/',
        title: 'Blood Volume',
        tag: 'Calculator',
        description: 'Nadler, Lemmens and Gilcher estimates, plus the ATLS haemorrhagic shock classes.',
    },
    {
        href: '/sunwalk/',
        title: 'Sun Walk',
        tag: 'App',
        description: 'Sunrise, sunset, golden hour and twilight phases through the day.',
    },
];

const groups = [...new Set(pages.map((p) => p.tag))].map((tag) => ({tag, items: pages.filter((p) => p.tag === tag)}));
---

<Layout
    title="Pages - Patrick Scheid"
    description="A directory of the small tools and pages on this site that aren't linked from the navigation."
    pageClass="site page-pages"
>
    <header class="grid page-head">
        <h1>Pages</h1>
        <p class="page-dek">Small tools that live off the beaten path — none of these appear in the menu.</p>
    </header>

    {groups.map((group) => (
        <section class="grid section">
            <h2 class="index label">{group.tag}s</h2>
            <ul class="ledger">
                {group.items.map((page) => (
                    <li>
                        <a class="ledger-title" href={page.href}>{page.title}</a>
                        <p class="ledger-text">{page.description}</p>
                    </li>
                ))}
            </ul>
        </section>
    ))}
</Layout>

<style>
    .page-head h1 {
        font-size: 2.5rem;
        letter-spacing: -0.02em;
        margin: 0 0 0.4rem;
    }

    .page-dek {
        font-family: var(--font-text);
        font-size: 1.2rem;
        color: var(--color-text-muted);
        margin: 0;
    }
</style>
