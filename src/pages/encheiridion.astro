---
import Layout from '../layouts/Layout.astro';
import book from '../data/encheiridion.json';

const chapters = book.chapters;
const total = chapters.length;

const firstHeading = (chapter: (typeof chapters)[number]) =>
    chapter.sections.find((section) => section.heading)?.heading ?? '';
---

<Layout
    title="Encheiridion - Patrick Scheid"
    description="Epictetus' Handbüchlein der stoischen Moral in Carl Conz's 1864 German translation. Browse all 53 chapters or open one at random."
    pageClass="page-encheiridion"
>
    <section class="book" id="book" aria-labelledby="book-title">
        <header class="book-header">
            <p class="eyebrow">Epictetus &middot; Stoic handbook</p>
            <h1 id="book-title">Encheiridion</h1>
            <p class="tagline">
                <em lang="de">Handbüchlein der stoischen Moral</em>, compiled by Arrian and translated into German by Carl Conz in 1864.
            </p>
            <div class="book-actions">
                <button class="btn btn-primary" type="button" data-random>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="16 3 21 3 21 8"/>
                        <line x1="4" y1="20" x2="21" y2="3"/>
                        <polyline points="21 16 21 21 16 21"/>
                        <line x1="15" y1="15" x2="21" y2="21"/>
                        <line x1="4" y1="4" x2="9" y2="9"/>
                    </svg>
                    <span>Open a random chapter</span>
                </button>
                <span class="book-hint">{total} chapters</span>
            </div>
        </header>

        <nav class="toc" aria-label="Chapters">
            <ol class="toc-list">
                {chapters.map((chapter) => (
                    <li>
                        <a class="toc-item" href={`#${chapter.number}`}>
                            <span class="toc-number">{chapter.roman}</span>
                            <span class="toc-heading" lang="de">{firstHeading(chapter)}</span>
                        </a>
                    </li>
                ))}
            </ol>
        </nav>

        <div class="reader">
            <div class="reader-bar">
                <a class="reader-link" href="#">&larr; All chapters</a>
                <span class="reader-position" data-position aria-live="polite"></span>
                <button class="reader-link" type="button" data-random>Random</button>
            </div>

            {chapters.map((chapter) => (
                <article class="chapter" id={`chapter-${chapter.number}`} data-chapter={chapter.number} lang="de">
                    <header class="chapter-header">
                        <span class="chapter-roman">{chapter.roman}</span>
                        <span class="chapter-label">Kapitel {chapter.number}</span>
                    </header>
                    {chapter.sections.map((section) => (
                        <div class="chapter-section">
                            {section.heading && <h2>{section.heading}</h2>}
                            <p>{section.text}</p>
                        </div>
                    ))}
                    <details class="commentary">
                        <summary>
                            <span class="commentary-label">Kommentar</span>
                            <span class="commentary-hint">Lesehilfe, von einer KI geschrieben</span>
                        </summary>
                        <div class="commentary-body">
                            {chapter.commentary.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
                        </div>
                    </details>
                </article>
            ))}

            <nav class="pager" aria-label="Chapter navigation">
                <a class="pager-link" data-prev href="#">
                    <span class="pager-direction">&larr; Previous</span>
                    <span class="pager-title" data-prev-title lang="de"></span>
                </a>
                <a class="pager-link pager-next" data-next href="#">
                    <span class="pager-direction">Next &rarr;</span>
                    <span class="pager-title" data-next-title lang="de"></span>
                </a>
            </nav>
        </div>

        <footer class="book-footer">
            <p>
                Text: {book.author}, <em lang="de">{book.title}</em>, translated by {book.translator} ({book.translation_year}).
                Public domain, taken from <a href={book.source} target="_blank" rel="noopener noreferrer">zeno.org</a>.
                Chapters 1–53 follow the standard numbering; section headings are the translator's.
            </p>
            <p lang="de">{book.commentary_note}</p>
            <p class="book-keys">Keyboard: <kbd>←</kbd> <kbd>→</kbd> previous / next chapter, <kbd>R</kbd> random, <kbd>Esc</kbd> back to the index.</p>
        </footer>
    </section>
</Layout>

<script>
    const book = document.querySelector<HTMLElement>('#book');
    const chapters = Array.from(document.querySelectorAll<HTMLElement>('.chapter'));
    const total = chapters.length;
    const headings = chapters.map((chapter) => chapter.querySelector('h2')?.textContent ?? '');

    const position = document.querySelector<HTMLElement>('[data-position]');
    const prevLink = document.querySelector<HTMLAnchorElement>('[data-prev]');
    const nextLink = document.querySelector<HTMLAnchorElement>('[data-next]');
    const prevTitle = document.querySelector<HTMLElement>('[data-prev-title]');
    const nextTitle = document.querySelector<HTMLElement>('[data-next-title]');
    const baseTitle = document.title;

    const commentaries = Array.from(document.querySelectorAll<HTMLDetailsElement>('.commentary'));
    const commentaryKey = 'encheiridion-commentary';

    let current = 0;

    function readCommentaryPreference(): boolean {
        try {
            return localStorage.getItem(commentaryKey) === 'open';
        } catch {
            return false;
        }
    }

    function applyCommentaryPreference() {
        const open = readCommentaryPreference();
        for (const details of commentaries) {
            details.open = open;
        }
    }

    // Opening or closing the commentary in one chapter applies to all of them,
    // and the choice is remembered. Only a state change triggers 'toggle', so
    // syncing the others cannot loop.
    for (const details of commentaries) {
        details.addEventListener('toggle', () => {
            try {
                localStorage.setItem(commentaryKey, details.open ? 'open' : 'closed');
            } catch {
                // storage unavailable; ignore
            }
            for (const other of commentaries) {
                if (other.open !== details.open) other.open = details.open;
            }
        });
    }

    function chapterFromHash(): number {
        const number = Number.parseInt(location.hash.slice(1), 10);
        return Number.isInteger(number) && number >= 1 && number <= total ? number : 0;
    }

    function render(scroll: boolean) {
        current = chapterFromHash();
        if (!book) return;

        book.classList.toggle('is-reading', current > 0);
        book.classList.toggle('is-index', current === 0);

        if (current === 0) {
            document.title = baseTitle;
            return;
        }

        for (const chapter of chapters) {
            chapter.classList.toggle('is-active', Number(chapter.dataset.chapter) === current);
        }

        const prev = current > 1 ? current - 1 : total;
        const next = current < total ? current + 1 : 1;

        if (position) position.textContent = `Chapter ${current} of ${total}`;
        if (prevLink) prevLink.href = `#${prev}`;
        if (nextLink) nextLink.href = `#${next}`;
        if (prevTitle) prevTitle.textContent = `${prev}. ${headings[prev - 1]}`;
        if (nextTitle) nextTitle.textContent = `${next}. ${headings[next - 1]}`;

        document.title = `${current}. ${headings[current - 1]} · Encheiridion`;

        if (scroll) {
            window.scrollTo({top: 0, behavior: 'auto'});
        }
    }

    function goTo(number: number) {
        location.hash = number > 0 ? String(number) : '';
    }

    function goRandom() {
        if (total < 2) return goTo(1);
        let pick = current;
        while (pick === current) {
            pick = 1 + Math.floor(Math.random() * total);
        }
        goTo(pick);
    }

    for (const button of document.querySelectorAll('[data-random]')) {
        button.addEventListener('click', goRandom);
    }

    document.addEventListener('keydown', (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        const target = event.target as HTMLElement | null;
        if (target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)) return;

        switch (event.key) {
            case 'ArrowRight':
                if (current > 0) goTo(current < total ? current + 1 : 1);
                break;
            case 'ArrowLeft':
                if (current > 0) goTo(current > 1 ? current - 1 : total);
                break;
            case 'r':
            case 'R':
                goRandom();
                break;
            case 'Escape':
                if (current > 0) goTo(0);
                break;
        }
    });

    window.addEventListener('hashchange', () => render(true));
    applyCommentaryPreference();
    render(false);
</script>

<style>
    :global(body.page-encheiridion main) {
        width: 100%;
        max-width: 48rem;
    }

    .book {
        display: grid;
        gap: 2rem;
        margin: 0 auto;
    }

    /* Without JS, everything is visible and the page reads top to bottom. */
    .book.is-index .reader,
    .book.is-reading .book-header,
    .book.is-reading .toc,
    .book.is-reading .chapter:not(.is-active) {
        display: none;
    }

    .book-header {
        padding-top: 1rem;
        text-align: center;
    }

    .eyebrow {
        margin: 0 0 0.35rem;
        color: var(--color-accent);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .book-header h1 {
        margin-bottom: 0.4rem;
    }

    .tagline {
        margin: 0 auto;
        max-width: 34rem;
        color: var(--color-text-muted);
        font-size: 1.1rem;
    }

    .book-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .book-hint {
        color: var(--color-text-muted);
        font-size: 0.9rem;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        padding: 0.7em 1.2em;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
        color: var(--color-text);
        font: 600 0.95rem/1 "Atkinson", sans-serif;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease, transform 0.15s ease;
    }

    .btn:hover {
        transform: translateY(-1px);
    }

    .btn-primary {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: #fff;
    }

    .btn-primary:hover {
        background: var(--color-accent-dark);
        border-color: var(--color-accent-dark);
    }

    .toc-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
        gap: 0.6rem;
    }

    .toc-item {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        height: 100%;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface);
        color: var(--color-text);
        line-height: 1.35;
        transition: border-color 0.2s ease, transform 0.15s ease;
    }

    .toc-item:hover {
        border-color: var(--color-accent);
        color: var(--color-text);
        transform: translateY(-1px);
    }

    .toc-number {
        flex-shrink: 0;
        min-width: 2.2rem;
        color: var(--color-accent);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
    }

    .toc-heading {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--color-text-heading);
        hyphens: auto;
    }

    .toc-item:hover .toc-heading {
        color: var(--color-accent);
    }

    .reader {
        display: grid;
        gap: 1.5rem;
    }

    .reader-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
    }

    .reader-link {
        margin: 0;
        padding: 0;
        border: 0;
        background: none;
        color: var(--color-text-muted);
        font: 600 0.9rem/1.4 "Atkinson", sans-serif;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .reader-link:hover {
        color: var(--color-accent);
    }

    .reader-position {
        color: var(--color-text-muted);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .chapter {
        hyphens: auto;
    }

    .chapter-header {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .chapter-roman {
        color: var(--color-text-heading);
        font-size: 2.75rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.02em;
    }

    .chapter-label {
        color: var(--color-text-muted);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .chapter-section h2 {
        margin: 1.75rem 0 0.5rem;
        font-size: 1.25rem;
    }

    .chapter-section:first-of-type h2 {
        margin-top: 0;
    }

    .chapter-section p {
        margin: 0 0 1.25em;
        font-size: 1.1rem;
        line-height: 1.75;
        white-space: pre-line;
    }

    .commentary {
        margin-top: 1.5rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface);
    }

    .commentary summary {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        padding: 0.8rem 1.1rem;
        cursor: pointer;
        list-style: none;
    }

    .commentary summary::-webkit-details-marker {
        display: none;
    }

    .commentary summary::before {
        content: "";
        flex-shrink: 0;
        align-self: center;
        width: 0.45rem;
        height: 0.45rem;
        border-right: 2px solid var(--color-text-muted);
        border-bottom: 2px solid var(--color-text-muted);
        transform: rotate(-45deg);
        transition: transform 0.2s ease;
    }

    .commentary[open] summary::before {
        transform: rotate(45deg);
    }

    .commentary summary:hover .commentary-label {
        color: var(--color-accent);
    }

    .commentary-label {
        color: var(--color-text-heading);
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .commentary-hint {
        color: var(--color-text-muted);
        font-size: 0.85rem;
    }

    .commentary-body {
        padding: 0 1.1rem 0.5rem;
        border-top: 1px solid var(--color-border);
    }

    .commentary-body p {
        margin: 1em 0;
        font-size: 0.98rem;
        line-height: 1.65;
        color: var(--color-text);
    }

    .pager {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }

    .pager-link {
        display: grid;
        gap: 0.25rem;
        padding: 0.9rem 1.1rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: var(--color-surface);
        color: var(--color-text);
        transition: border-color 0.2s ease, transform 0.15s ease;
    }

    .pager-link:hover {
        border-color: var(--color-accent);
        color: var(--color-text);
        transform: translateY(-1px);
    }

    .pager-next {
        text-align: right;
    }

    .pager-direction {
        color: var(--color-text-muted);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .pager-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text-heading);
        hyphens: auto;
    }

    .pager-link:hover .pager-title {
        color: var(--color-accent);
    }

    .book-footer {
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        color: var(--color-text-muted);
        font-size: 0.85rem;
        line-height: 1.6;
    }

    .book-footer p {
        margin: 0 0 0.6em;
    }

    .book-keys {
        opacity: 0.85;
    }

    kbd {
        display: inline-block;
        padding: 0 0.4em;
        border: 1px solid var(--color-border);
        border-bottom-width: 2px;
        border-radius: 4px;
        background: var(--color-surface);
        font: 600 0.8em/1.6 "Atkinson", sans-serif;
    }

    @media (max-width: 600px) {
        .toc-list {
            grid-template-columns: 1fr;
        }

        .pager {
            grid-template-columns: 1fr;
        }

        .pager-next {
            text-align: left;
        }

        .chapter-roman {
            font-size: 2.25rem;
        }

        .book-keys {
            display: none;
        }
    }
</style>
