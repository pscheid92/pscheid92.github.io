---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="CPR Metronome (110 BPM) - Patrick Scheid"
    description="A CPR metronome that beeps at 110 beats per minute — the recommended chest compression rate. One tap to start, a screen that stays awake, and nothing else to think about."
    pageClass="page-cpr"
>
    <section class="metronome-shell" aria-labelledby="cpr-title">
        <div class="page-header">
            <p class="eyebrow">Emergency tool</p>
            <h1 id="cpr-title">CPR Metronome</h1>
            <p class="tagline">110 beats per minute — push hard, push fast, follow the pulse.</p>
        </div>

        <div class="beat-stage">
            <button id="beat-button" class="beat-button" type="button" aria-pressed="false">
                <span class="ripple" id="ripple" aria-hidden="true"></span>
                <svg class="heart" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                <span class="count" id="count">Start</span>
                <span class="sub" id="sub">tap to begin</span>
            </button>
            <p class="sr-only" id="status" role="status">Metronome stopped.</p>
        </div>

        <div class="stat-row">
            <div class="stat">
                <span class="stat-label">Elapsed</span>
                <strong id="elapsed">0:00</strong>
            </div>
            <div class="stat">
                <span class="stat-label">Compressions</span>
                <strong id="total">0</strong>
            </div>
        </div>

        <div class="control-row">
            <button id="reset" class="reset-button" type="button" disabled>Reset counters</button>
        </div>

        <p class="note">
            Call 112 (Europe) or 911 (US) first. Push at least 5&nbsp;cm deep in the centre of the
            chest and don't stop. Works offline once loaded. Not a substitute for CPR training.
        </p>
    </section>
</Layout>

<script>
    const BPM = 110;
    const SECONDS_PER_BEAT = 60 / BPM;
    const SCHEDULER_INTERVAL_MS = 30;
    const TONE_CLICK = {freq: 1047, peak: 0.7, decay: 0.08};

    const beatButton = document.querySelector('#beat-button');
    const ripple = document.querySelector('#ripple');
    const countOutput = document.querySelector('#count');
    const subOutput = document.querySelector('#sub');
    const elapsedOutput = document.querySelector('#elapsed');
    const totalOutput = document.querySelector('#total');
    const resetButton = document.querySelector('#reset');
    const statusOutput = document.querySelector('#status');

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let audioContext = null;
    let masterGain = null;
    let schedulerId = 0;
    let elapsedId = 0;
    let wakeLock = null;
    let running = false;
    let runToken = 0;

    let nextBeatTime = 0;
    let totalBeats = 0;
    let activeMs = 0;
    let runStartedAt = 0;

    function setOutput(element, value) {
        if (element) {
            element.textContent = value;
        }
    }

    function formatElapsed(ms) {
        const totalSeconds = Math.floor(ms / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        return `${minutes}:${String(seconds).padStart(2, '0')}`;
    }

    function updateElapsed() {
        const ms = activeMs + (running ? performance.now() - runStartedAt : 0);
        setOutput(elapsedOutput, formatElapsed(ms));
    }

    // Beeps are scheduled on the Web Audio clock; setInterval only tops up the
    // queue, so timer jitter and background throttling never shift the beat.
    function scheduleAheadSeconds() {
        return document.hidden ? 1.2 : 0.15;
    }

    function playClick(time) {
        if (!masterGain) {
            return;
        }
        const osc = audioContext.createOscillator();
        const gain = audioContext.createGain();
        osc.type = 'triangle';
        osc.frequency.value = TONE_CLICK.freq;
        gain.gain.setValueAtTime(0.0001, time);
        gain.gain.exponentialRampToValueAtTime(TONE_CLICK.peak, time + 0.004);
        gain.gain.exponentialRampToValueAtTime(0.0001, time + TONE_CLICK.decay);
        osc.connect(gain).connect(masterGain);
        osc.start(time);
        osc.stop(time + TONE_CLICK.decay + 0.05);
    }

    function onBeatVisual(beatTotal) {
        setOutput(totalOutput, String(beatTotal));

        if (beatButton && !reducedMotion.matches) {
            beatButton.animate(
                [
                    {transform: 'scale(1)'},
                    {transform: 'scale(1.045)', offset: 0.3},
                    {transform: 'scale(1)'},
                ],
                {duration: 220, easing: 'ease-out'},
            );
        }

        ripple?.animate(
            [
                {opacity: 0.8, transform: 'scale(1)'},
                {opacity: 0, transform: reducedMotion.matches ? 'scale(1)' : 'scale(1.28)'},
            ],
            {duration: 450, easing: 'ease-out'},
        );

        if ('vibrate' in navigator) {
            navigator.vibrate(45);
        }
    }

    function scheduler() {
        while (running && nextBeatTime < audioContext.currentTime + scheduleAheadSeconds()) {
            totalBeats += 1;
            playClick(nextBeatTime);

            if (!document.hidden) {
                const beatTotal = totalBeats;
                const token = runToken;
                window.setTimeout(() => {
                    if (running && token === runToken) {
                        onBeatVisual(beatTotal);
                    }
                }, Math.max(0, (nextBeatTime - audioContext.currentTime) * 1000));
            }

            nextBeatTime += SECONDS_PER_BEAT;
        }
    }

    async function requestWakeLock() {
        if (!('wakeLock' in navigator)) {
            return;
        }
        try {
            wakeLock = await navigator.wakeLock.request('screen');
        } catch {
            wakeLock = null;
        }
    }

    function releaseWakeLock() {
        wakeLock?.release().catch(() => {});
        wakeLock = null;
    }

    async function start() {
        if (!audioContext) {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        try {
            // resume() can hang if the browser withholds audio permission —
            // never let that block the UI; audio joins once it settles.
            await Promise.race([
                audioContext.resume(),
                new Promise((resolve) => setTimeout(resolve, 1000)),
            ]);
        } catch {
            // keep going — the metronome UI still works without audio
        }
        masterGain = audioContext.createGain();
        masterGain.connect(audioContext.destination);

        running = true;
        runToken += 1;
        runStartedAt = performance.now();
        nextBeatTime = audioContext.currentTime + 0.08;
        scheduler();
        schedulerId = window.setInterval(scheduler, SCHEDULER_INTERVAL_MS);
        elapsedId = window.setInterval(updateElapsed, 250);
        requestWakeLock();

        beatButton?.classList.add('running');
        beatButton?.setAttribute('aria-pressed', 'true');
        setOutput(subOutput, 'tap to stop');
        setOutput(statusOutput, 'Metronome running at 110 beats per minute.');
        if (resetButton) {
            resetButton.disabled = true;
        }
    }

    function stop() {
        running = false;
        runToken += 1;
        window.clearInterval(schedulerId);
        window.clearInterval(elapsedId);
        activeMs += performance.now() - runStartedAt;
        masterGain?.disconnect();
        masterGain = null;
        releaseWakeLock();

        beatButton?.classList.remove('running');
        beatButton?.setAttribute('aria-pressed', 'false');
        setOutput(countOutput, totalBeats > 0 ? 'Resume' : 'Start');
        setOutput(subOutput, totalBeats > 0 ? 'tap to continue' : 'tap to begin');
        setOutput(statusOutput, 'Metronome stopped.');
        if (resetButton) {
            resetButton.disabled = false;
        }
        updateElapsed();
        setOutput(totalOutput, String(totalBeats));
    }

    function reset() {
        if (running) {
            return;
        }
        totalBeats = 0;
        activeMs = 0;
        setOutput(countOutput, 'Start');
        setOutput(subOutput, 'tap to begin');
        updateElapsed();
        setOutput(totalOutput, '0');
        if (resetButton) {
            resetButton.disabled = true;
        }
    }

    beatButton?.addEventListener('click', () => {
        if (running) {
            stop();
        } else {
            start();
        }
    });

    resetButton?.addEventListener('click', reset);

    document.addEventListener('visibilitychange', () => {
        if (!document.hidden && running) {
            requestWakeLock();
            setOutput(totalOutput, String(totalBeats));
        }
    });

    // Cache the page for offline use — dev builds skip this so Vite modules stay fresh.
    if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/cpr-sw.js', {scope: '/cpr'}).catch(() => {});
            // ask the browser not to evict the offline cache under storage pressure
            navigator.storage?.persist?.().catch(() => {});
        });
    }
</script>

<style>
    :global(body.page-cpr main) {
        width: 100%;
        max-width: 48rem;
    }

    .metronome-shell {
        --pulse: #d6203f;
        --pulse-deep: #9c1230;
        display: grid;
        gap: 1.5rem;
        max-width: 48rem;
        margin: 0 auto;
    }

    :global([data-theme="dark"]) .metronome-shell {
        --pulse: #e8334f;
        --pulse-deep: #8c1029;
    }

    .page-header {
        padding-top: 1rem;
        text-align: center;
    }

    .eyebrow {
        margin: 0 0 0.35rem;
        color: var(--pulse);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .page-header h1 {
        margin-bottom: 0.4rem;
    }

    .tagline {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 1.1rem;
    }

    .note {
        margin: 0 auto;
        max-width: 30rem;
        border-top: 1px solid var(--color-border);
        padding-top: 1.25rem;
        color: var(--color-text-muted);
        font-size: 0.92rem;
        line-height: 1.6;
        text-align: center;
    }

    .beat-stage {
        display: grid;
        justify-items: center;
        padding: 0.75rem 0;
    }

    .beat-button {
        position: relative;
        width: min(76vw, 19rem);
        aspect-ratio: 1;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 0.35rem;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        color: #fff;
        background: radial-gradient(
            circle at 32% 26%,
            color-mix(in srgb, var(--pulse) 72%, #ffffff) 0%,
            var(--pulse) 45%,
            var(--pulse-deep) 100%
        );
        box-shadow:
            0 18px 50px color-mix(in srgb, var(--pulse) 35%, transparent),
            inset 0 -10px 24px rgba(0, 0, 0, 0.2);
        transition: box-shadow 0.4s ease;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        user-select: none;
    }

    .beat-button::before {
        content: "";
        position: absolute;
        inset: -1.1rem;
        border: 1px solid color-mix(in srgb, var(--pulse) 30%, transparent);
        border-radius: 50%;
        pointer-events: none;
    }

    .beat-button.running {
        box-shadow:
            0 18px 60px color-mix(in srgb, var(--pulse) 50%, transparent),
            inset 0 -10px 24px rgba(0, 0, 0, 0.25);
    }

    .ripple {
        position: absolute;
        inset: -0.4rem;
        border: 4px solid var(--pulse);
        border-radius: 50%;
        opacity: 0;
        pointer-events: none;
    }

    .heart {
        display: none;
        width: 4.5rem;
        height: 4.5rem;
        fill: #fff;
        filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.25));
    }

    .beat-button.running .heart {
        display: block;
    }

    .beat-button.running .count {
        display: none;
    }

    .count {
        font-size: clamp(1.9rem, 8vw, 2.7rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.04em;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
    }

    .sub {
        max-width: 13rem;
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.35;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        opacity: 0.85;
    }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        max-width: 26rem;
        width: 100%;
        margin: 0 auto;
    }

    .stat {
        display: grid;
        justify-items: center;
        gap: 0.3rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 0.9rem 0.5rem;
        background: var(--color-surface);
    }

    .stat-label {
        color: var(--color-text-muted);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-align: center;
    }

    .stat strong {
        color: var(--color-text-heading);
        font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2rem);
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
    }

    .control-row {
        display: flex;
        justify-content: center;
    }

    .reset-button {
        border: none;
        background: none;
        padding: 0.3rem 0.6rem;
        color: var(--color-text-muted);
        font: 600 0.95rem/1.4 "Atkinson", sans-serif;
        cursor: pointer;
        text-decoration: underline;
        text-decoration-color: transparent;
        text-underline-offset: 3px;
        transition: color 0.2s ease, text-decoration-color 0.2s ease;
    }

    .reset-button:hover:not(:disabled) {
        color: var(--pulse);
        text-decoration-color: var(--pulse);
    }

    .reset-button:disabled {
        opacity: 0.45;
        cursor: default;
    }

    @media (max-width: 480px) {
        .stat-row {
            gap: 0.6rem;
        }

        .stat {
            padding: 0.7rem 0.35rem;
        }
    }
</style>
