---
import Layout from '../layouts/Layout.astro';

const fields = [
    {key: 'hold', label: 'Hold', hint: 'every round'},
    {key: 'rounds', label: 'Rounds', hint: 'how many'},
    {key: 'firstRest', label: 'First rest', hint: 'round 1'},
    {key: 'drop', label: 'Rest drops', hint: 'per round'},
];

const presets = [
    {key: 'gentle', label: 'Gentle'},
    {key: 'classic', label: 'Classic'},
    {key: 'advanced', label: 'Advanced'},
];
---

<Layout
    title="CO₂ Tolerance Table - Patrick Scheid"
    description="Run a CO₂ table for breath-hold training: the hold stays the same length while the rests get shorter round after round. Build your own table, then follow the countdown with audio cues. Dry-land practice only — never in or near water."
    pageClass="page-co2-table"
>
    <section class="co2-shell" data-phase="idle" data-mode="table" aria-labelledby="co2-title">
        <div class="page-header">
            <p class="eyebrow">Breathing tool</p>
            <h1 id="co2-title">CO₂ Tolerance Table</h1>
            <p class="tagline">Same hold every round. Shorter and shorter rests.</p>
        </div>

        <p class="safety-bar">
            <strong>Dry land only.</strong> Never in or near water, never alone, never after hyperventilating.
        </p>

        <nav class="modes" aria-label="Mode">
            <button class="mode active" type="button" data-mode="table">Run a table</button>
            <button class="mode" type="button" data-mode="test">Find your hold</button>
        </nav>

        <div class="dial">
            <svg class="ring" viewBox="0 0 220 220" aria-hidden="true">
                <circle class="ring-track" cx="110" cy="110" r="96"/>
                <circle class="ring-arc" id="ring" cx="110" cy="110" r="96" transform="rotate(-90 110 110)"/>
            </svg>
            <div class="dial-face">
                <span class="phase" id="phase">Ready</span>
                <span class="clock" id="clock">0:00</span>
                <span class="round" id="round">8 rounds</span>
            </div>
        </div>

        <p class="hint" id="hint">Press start, then close your eyes and follow the cues.</p>
        <p class="next" id="next">Opens with 2:00 of breathing.</p>

        <div class="overall" aria-hidden="true">
            <div class="overall-fill" id="overall-fill"></div>
        </div>
        <p class="overall-label" id="overall-label">17:00 total</p>

        <p class="sr-only" id="live" aria-live="polite" role="status"></p>

        <div class="controls">
            <button id="start" type="button">Start</button>
            <button id="pause" type="button" disabled>Pause</button>
            <button id="reset" type="button" disabled>Reset</button>
            <button id="sound" type="button" aria-pressed="true">Sound: on</button>
        </div>

        <div class="panel panel-table">
            <div class="setup" id="setup">
                <div class="presets" role="group" aria-label="Table presets">
                    {presets.map((preset) => (
                        <button type="button" class="preset" data-preset={preset.key}>{preset.label}</button>
                    ))}
                </div>

                <div class="fields">
                    {fields.map((field) => (
                        <div class="field">
                            <span class="field-label" id={`${field.key}-label`}>
                                {field.label}
                                <span class="field-hint">{field.hint}</span>
                            </span>
                            <div class="stepper">
                                <button type="button" data-field={field.key} data-step="-1" aria-label={`Decrease ${field.label.toLowerCase()}`}>−</button>
                                <output id={`${field.key}-value`} aria-labelledby={`${field.key}-label`}>—</output>
                                <button type="button" data-field={field.key} data-step="1" aria-label={`Increase ${field.label.toLowerCase()}`}>+</button>
                            </div>
                        </div>
                    ))}
                </div>

                <p class="summary" id="summary"></p>
            </div>

            <div class="plan-wrap">
                <table class="plan">
                    <caption class="sr-only">Round by round plan</caption>
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Breathe</th>
                            <th scope="col">Hold</th>
                            <th scope="col">Clock</th>
                        </tr>
                    </thead>
                    <tbody id="plan-body"></tbody>
                </table>
            </div>
        </div>

        <div class="panel panel-test">
            <ol class="test-steps">
                <li><strong>Sit or lie down</strong> somewhere soft, away from water, with nothing you could fall against.</li>
                <li><strong>Two minutes of calm breathing.</strong> Normal breaths in and out. Deep or fast breathing makes the number bigger and the test more dangerous.</li>
                <li><strong>One normal breath in, then hold.</strong> Not a maximal gulp of air.</li>
                <li><strong>Stop at the first firm contractions</strong> — the involuntary kicks of your diaphragm. That is the number this page wants. It is not a maximum attempt, and pushing past it on your own is how people black out.</li>
                <li><strong>Breathe out and recover</strong> with easy breaths for a minute before you stand up.</li>
            </ol>

            <div class="test-result" id="test-result" hidden>
                <p class="tr-head">Comfortable hold</p>
                <p class="tr-value" id="tr-measured">—</p>
                <p class="tr-line">Suggested table hold <strong id="tr-suggested">—</strong>, about two thirds of what you just did.</p>
                <button id="apply-hold" type="button">Use it</button>
            </div>

            <p class="test-last" id="test-last"></p>
        </div>

        <div class="prose explainer">
            <h2>What a CO₂ table trains</h2>
            <p>
                The hold length never changes; the rest between holds keeps shrinking. Each round therefore
                starts with more carbon dioxide still in you, so the urge to breathe arrives sooner and bites
                harder. You are training your tolerance of that urge — the contractions, the burning — not your
                oxygen reserve. Growing the reserve is what an O₂ table does, with a fixed rest and holds that
                get longer.
            </p>
            <p>
                Breathe <em>normally</em> during the rests: calm belly breaths, no deep or fast breathing.
                Hyperventilation blows off the very CO₂ you came to train, and it strips out the warning
                signals that keep breath-holding safe.
            </p>

            <h2>Picking your hold length</h2>
            <p>
                The usual rule is half of your maximum static hold. But finding a true maximum means holding to
                the edge of blacking out, which is not something to do alone in your living room. So
                <strong>Find your hold</strong> measures something safer and far more repeatable: two minutes of
                calm breathing, then a single hold you end at the <em>first firm contractions</em> of your
                diaphragm. Two thirds of that becomes the suggested table hold, which for most people lands near
                the classic half-of-max figure without ever asking you to go looking for your limit.
            </p>
            <p>
                Treat the suggestion as a starting point and let the table correct it. Finish the last round
                with something left over: add 5 seconds next time. Have to break a hold early: take 5 seconds
                off. Retest every few weeks, because the number moves.
            </p>
            <p>
                One table a session is plenty, at most once or twice a day, and not straight after a meal.
                Lie or sit down somewhere soft, stop at dizziness, tingling or tunnel vision, and never train
                where losing consciousness could put your face in water.
            </p>
            <p class="keys">
                <kbd>Space</kbd> starts and pauses · <kbd>Esc</kbd> resets.
            </p>
        </div>

        <p class="note disclaimer">
            This page is a practice timer, not medical advice and not a substitute for supervised instruction.
            Breath-hold training can cause a blackout without warning. Train dry, train with a buddy, and if you
            have heart, lung, blood-pressure or seizure conditions, or you are pregnant, talk to a doctor first.
        </p>
    </section>
</Layout>

<script>
    const MIN_REST = 15;
    const LIMITS = {
        hold: {min: 10, max: 240, step: 5},
        rounds: {min: 3, max: 12, step: 1},
        firstRest: {min: 20, max: 300, step: 5},
        drop: {min: 0, max: 45, step: 5},
    };
    const PRESETS = {
        gentle: {hold: 30, rounds: 8, firstRest: 120, drop: 10},
        classic: {hold: 60, rounds: 8, firstRest: 120, drop: 15},
        advanced: {hold: 90, rounds: 8, firstRest: 135, drop: 15},
    };
    const STORE_KEY = 'co2-table';
    const TEST_PREP = 120;      // calm breathing before the test hold
    const TEST_MIN = 10;        // shorter than this is a mis-tap, not a hold
    const TEST_FACTOR = 2 / 3;  // table hold as a share of the comfortable hold

    const $ = (id) => document.getElementById(id);
    const shell = document.querySelector('.co2-shell');
    const ring = $('ring'), phaseEl = $('phase'), clockEl = $('clock'), roundEl = $('round');
    const hintEl = $('hint'), nextEl = $('next'), liveEl = $('live');
    const fillEl = $('overall-fill'), overallEl = $('overall-label'), summaryEl = $('summary');
    const planBody = $('plan-body'), setupEl = $('setup');
    const startBtn = $('start'), pauseBtn = $('pause'), resetBtn = $('reset'), soundBtn = $('sound');
    const modeBtns = document.querySelectorAll('.mode'), dialEl = document.querySelector('.dial');
    const testResult = $('test-result'), trMeasured = $('tr-measured'), trSuggested = $('tr-suggested');
    const applyBtn = $('apply-hold'), testLastEl = $('test-last');

    const CIRC = 2 * Math.PI * 96;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = (secs) => {
        const t = Math.max(0, Math.round(secs));
        return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0');
    };
    const clamp = (n, {min, max}) => Math.min(max, Math.max(min, n));

    /* ================= settings & plan ================= */
    const settings = {...PRESETS.classic};
    let soundOn = true;
    let lastTest = null;    // {secs, at} of the most recent hold test
    let plan = [];      // [{kind, round, secs}]
    let bounds = [];    // absolute end time of each phase, in seconds from the start
    let total = 0;

    const restFor = (i) => Math.max(MIN_REST, settings.firstRest - i * settings.drop);

    function load() {
        try {
            const saved = JSON.parse(localStorage.getItem(STORE_KEY) || '{}');
            for (const key of Object.keys(LIMITS)) {
                if (Number.isFinite(saved[key])) settings[key] = clamp(saved[key], LIMITS[key]);
            }
            if (typeof saved.sound === 'boolean') soundOn = saved.sound;
            if (saved.lastTest && Number.isFinite(saved.lastTest.secs)) lastTest = saved.lastTest;
        } catch {
            // no stored table, or storage is blocked — the defaults are fine
        }
    }
    function save() {
        try {
            localStorage.setItem(STORE_KEY, JSON.stringify({...settings, sound: soundOn, lastTest}));
        } catch {
            // private mode: the table just won't be remembered
        }
    }

    function buildPlan() {
        plan = [];
        bounds = [];
        let acc = 0;
        for (let i = 0; i < settings.rounds; i++) {
            plan.push({kind: 'breathe', round: i + 1, secs: restFor(i)});
            plan.push({kind: 'hold', round: i + 1, secs: settings.hold});
        }
        for (const step of plan) {
            acc += step.secs;
            bounds.push(acc);
        }
        total = acc;
    }

    function renderPlan() {
        const rows = [];
        let acc = 0;
        for (let i = 0; i < settings.rounds; i++) {
            acc += restFor(i) + settings.hold;
            rows.push(
                '<tr><th scope="row">' + (i + 1) + '</th>' +
                '<td class="c-breathe">' + fmt(restFor(i)) + '</td>' +
                '<td class="c-hold">' + fmt(settings.hold) + '</td>' +
                '<td class="c-clock">' + fmt(acc) + '</td></tr>',
            );
        }
        planBody.innerHTML = rows.join('');
    }

    function renderSettings() {
        for (const key of Object.keys(LIMITS)) {
            const el = $(key + '-value');
            if (el) el.textContent = key === 'rounds' ? String(settings.rounds) : fmt(settings[key]);
        }
        const last = restFor(settings.rounds - 1);
        summaryEl.textContent =
            'Rest ' + fmt(settings.firstRest) + ' → ' + fmt(last) +
            ' · ' + settings.rounds + ' holds of ' + fmt(settings.hold) +
            ' · ' + fmt(total) + ' total';
    }

    function markProgress(idx) {
        const rows = planBody.children;
        for (let i = 0; i < rows.length; i++) {
            const row = rows[i];
            const breatheIdx = i * 2, holdIdx = i * 2 + 1;
            row.classList.toggle('active', idx === breatheIdx || idx === holdIdx);
            row.classList.toggle('done', idx > holdIdx);
            row.querySelector('.c-breathe').classList.toggle('on', idx === breatheIdx);
            row.querySelector('.c-hold').classList.toggle('on', idx === holdIdx);
        }
    }

    function rebuild() {
        buildPlan();
        renderPlan();
        renderSettings();
        renderIdle();
    }

    /* ================= audio ================= */
    let ac = null, master = null;

    function ensureAudio() {
        ac = ac || new (window.AudioContext || window.webkitAudioContext)();
        if (!master) {
            master = ac.createGain();
            master.connect(ac.destination);
        }
        master.gain.cancelScheduledValues(0);
        master.gain.setValueAtTime(1, ac.currentTime);
        ac.resume();
    }
    function silence() {
        if (!ac) return;
        master.gain.cancelScheduledValues(0);
        master.gain.setValueAtTime(0, ac.currentTime);
    }
    function tone(at, freq, dur, vol) {
        const osc = ac.createOscillator(), gain = ac.createGain();
        osc.type = 'sine';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.0001, at);
        gain.gain.exponentialRampToValueAtTime(vol, at + 0.012);
        gain.gain.exponentialRampToValueAtTime(0.0001, at + dur);
        osc.connect(gain).connect(master);
        osc.start(at);
        osc.stop(at + dur + 0.02);
    }
    const cues = {
        // rising pair: let go, breathe again
        breathe: (at) => {
            tone(at, 494, 0.22, 0.3);
            tone(at + 0.16, 740, 0.3, 0.3);
        },
        // falling pair: last breath in, hold
        hold: (at) => {
            tone(at, 740, 0.22, 0.3);
            tone(at + 0.16, 392, 0.4, 0.3);
        },
        countdown: (at) => tone(at, 1046, 0.07, 0.18),
        mark: (at) => tone(at, 880, 0.08, 0.13),
        done: (at) => {
            tone(at, 523, 0.25, 0.3);
            tone(at + 0.2, 659, 0.25, 0.3);
            tone(at + 0.4, 784, 0.6, 0.3);
        },
    };

    // Schedules every remaining cue up front, so they stay on time even when the
    // tab is backgrounded and timers get throttled to one tick per second.
    function scheduleCues(from) {
        if (!soundOn || !ac) return;
        const base = ac.currentTime + 0.06 - from;
        if (from < 0.05) cues.breathe(base);
        for (let i = 0; i < bounds.length; i++) {
            const end = bounds[i];
            if (end <= from) continue;
            for (let k = 3; k >= 1; k--) {
                if (end - k > from) cues.countdown(base + end - k);
            }
            if (i === bounds.length - 1) cues.done(base + end);
            else cues[plan[i + 1].kind](base + end);
        }
    }

    /* ================= screen wake lock ================= */
    let wakeLock = null, wakePending = false;
    async function keepAwake(on) {
        if (!('wakeLock' in navigator)) return;
        try {
            if (on && !wakeLock && !wakePending) {
                wakePending = true;
                wakeLock = await navigator.wakeLock.request('screen');
                wakeLock.addEventListener('release', () => (wakeLock = null));
            } else if (!on && wakeLock) {
                await wakeLock.release();
            }
        } catch {
            // denied or unsupported — the table runs without it
        } finally {
            wakePending = false;
        }
    }
    document.addEventListener('visibilitychange', () => {
        // the browser drops the lock when the tab is hidden; take it again on return
        if (!document.hidden && (running || testPhase === 'prep' || testPhase === 'hold')) keepAwake(true);
    });

    /* ================= run loop ================= */
    let running = false, paused = false, done = false;
    let runT0 = 0, consumed = 0, curIdx = -1, ticker = 0;

    const HINTS = {
        idle: 'Press start, then close your eyes and follow the cues.',
        breathe: 'Breathe normally. No deep or fast breathing.',
        hold: 'Hold. Stay soft, let the urge come and pass.',
        paused: 'Paused — resume when you have your rhythm back.',
        done: 'Table complete. Breathe easy for a minute before you get up.',
    };

    function indexAt(elapsed) {
        for (let i = Math.max(0, curIdx); i < bounds.length; i++) {
            if (elapsed < bounds[i]) return i;
        }
        return bounds.length - 1;
    }

    function setRing(fraction, phase) {
        ring.style.strokeDasharray = String(CIRC);
        ring.style.strokeDashoffset = String(CIRC * (1 - Math.min(1, Math.max(0, fraction))));
        shell.dataset.phase = phase;
    }

    function renderIdle() {
        curIdx = -1;
        setRing(1, 'idle');
        phaseEl.textContent = 'Ready';
        clockEl.textContent = fmt(total);
        roundEl.textContent = settings.rounds + ' rounds';
        hintEl.textContent = HINTS.idle;
        nextEl.textContent = 'Opens with ' + fmt(restFor(0)) + ' of breathing.';
        fillEl.style.width = '0%';
        overallEl.textContent = fmt(total) + ' total';
        markProgress(-1);
    }

    function announce(step) {
        liveEl.textContent = (step.kind === 'hold' ? 'Hold ' : 'Breathe ') + fmt(step.secs) +
            ' — round ' + step.round + ' of ' + settings.rounds;
    }

    function onPhaseChange(step) {
        markProgress(curIdx);
        announce(step);
        if (navigator.vibrate) navigator.vibrate(step.kind === 'hold' ? [90, 70, 90] : 180);
    }

    function tick() {
        const elapsed = (performance.now() - runT0) / 1000;
        if (elapsed >= total) {
            finish();
            return;
        }
        const idx = indexAt(elapsed);
        const step = plan[idx];
        if (idx !== curIdx) {
            curIdx = idx;
            onPhaseChange(step);
        }
        const left = bounds[idx] - elapsed;
        phaseEl.textContent = step.kind === 'hold' ? 'Hold' : 'Breathe';
        clockEl.textContent = fmt(Math.ceil(left));
        roundEl.textContent = 'Round ' + step.round + ' of ' + settings.rounds;
        hintEl.textContent = HINTS[step.kind];
        const upcoming = plan[idx + 1];
        nextEl.textContent = upcoming
            ? 'Next: ' + (upcoming.kind === 'hold' ? 'hold ' : 'breathe ') + fmt(upcoming.secs)
            : 'Last hold of the table.';
        setRing(left / step.secs, step.kind);
        fillEl.style.width = (elapsed / total) * 100 + '%';
        overallEl.textContent = fmt(total - elapsed) + ' left of ' + fmt(total);
    }

    function begin(from) {
        ensureAudio();
        runT0 = performance.now() - from * 1000;
        curIdx = from > 0 ? indexAt(from) : -1;
        scheduleCues(from);
        clearInterval(ticker);
        ticker = window.setInterval(tick, 100);
        running = true;
        paused = false;
        done = false;
        keepAwake(true);
        syncControls();
        tick();
    }

    function pause() {
        if (!running) return;
        consumed = (performance.now() - runT0) / 1000;
        clearInterval(ticker);
        silence();
        running = false;
        paused = true;
        keepAwake(false);
        phaseEl.textContent = 'Paused';
        hintEl.textContent = HINTS.paused;
        syncControls();
    }

    function reset() {
        clearInterval(ticker);
        silence();
        running = false;
        paused = false;
        done = false;
        consumed = 0;
        liveEl.textContent = '';
        renderIdle();
        syncControls();
        keepAwake(false);
    }

    function finish() {
        clearInterval(ticker);
        running = false;
        paused = false;
        done = true;
        consumed = 0;
        curIdx = -1;
        setRing(1, 'done');
        phaseEl.textContent = 'Done';
        clockEl.textContent = fmt(total);
        roundEl.textContent = settings.rounds + ' rounds';
        hintEl.textContent = HINTS.done;
        nextEl.textContent = 'Same table again tomorrow — add 5 seconds when it stops feeling hard.';
        fillEl.style.width = '100%';
        overallEl.textContent = fmt(total) + ' complete';
        liveEl.textContent = 'Table complete.';
        markProgress(plan.length);
        keepAwake(false);
        syncControls();
        if (navigator.vibrate) navigator.vibrate([160, 90, 160, 90, 260]);
    }

    /* ================= hold test ================= */
    let mode = 'table';       // table | test
    let testPhase = 'idle';   // idle | prep | hold | result
    let testT0 = 0, testTicker = 0, marks = 0;

    const suggestFor = (secs) => clamp(Math.round((secs * TEST_FACTOR) / 5) * 5, LIMITS.hold);

    function fillResult(secs) {
        const suggested = suggestFor(secs);
        trMeasured.textContent = fmt(secs);
        trSuggested.textContent = fmt(suggested);
        applyBtn.textContent = 'Use ' + fmt(suggested) + ' as my hold';
        testResult.hidden = false;
    }

    function renderTestLast() {
        if (!lastTest) {
            testLastEl.textContent = 'No test yet. Results stay on this device.';
            return;
        }
        const when = new Date(lastTest.at).toLocaleDateString(undefined, {day: 'numeric', month: 'short'});
        testLastEl.textContent = 'Last test ' + fmt(lastTest.secs) + ' on ' + when +
            ' · suggested hold ' + fmt(suggestFor(lastTest.secs));
    }

    function renderTestIdle() {
        setRing(1, 'idle');
        phaseEl.textContent = 'Hold test';
        clockEl.textContent = fmt(TEST_PREP);
        roundEl.textContent = 'Breathe up, then hold';
        hintEl.textContent = 'Two minutes of calm breathing, then a single hold.';
        nextEl.textContent = 'Stop at the first firm contractions — this is not a maximum attempt.';
        if (lastTest) fillResult(lastTest.secs);
        else testResult.hidden = true;
        renderTestLast();
    }

    function testTick() {
        const elapsed = (performance.now() - testT0) / 1000;
        if (testPhase === 'prep') {
            const left = TEST_PREP - elapsed;
            if (left <= 0) {
                beginTestHold();
                return;
            }
            clockEl.textContent = fmt(Math.ceil(left));
            setRing(left / TEST_PREP, 'breathe');
            return;
        }
        clockEl.textContent = fmt(Math.floor(elapsed));
        // a soft landmark every 30 seconds, so the hold has a shape with eyes closed
        const passed = Math.floor(elapsed / 30);
        if (passed > marks) {
            marks = passed;
            if (soundOn && ac) cues.mark(ac.currentTime);
        }
    }

    function beginTestPrep() {
        ensureAudio();
        testPhase = 'prep';
        testT0 = performance.now();
        marks = 0;
        testResult.hidden = true;
        phaseEl.textContent = 'Breathe up';
        roundEl.textContent = 'Test';
        hintEl.textContent = 'Calm, normal breaths. No deep or fast breathing.';
        nextEl.textContent = 'Then one hold, ended at the first firm contractions.';
        liveEl.textContent = 'Breathe up for two minutes.';
        if (soundOn && ac) {
            const base = ac.currentTime + 0.06;
            cues.breathe(base);
            for (let k = 3; k >= 1; k--) cues.countdown(base + TEST_PREP - k);
            cues.hold(base + TEST_PREP);
        }
        clearInterval(testTicker);
        testTicker = window.setInterval(testTick, 100);
        keepAwake(true);
        syncControls();
        testTick();
    }

    function beginTestHold() {
        testPhase = 'hold';
        testT0 = performance.now();
        marks = 0;
        setRing(1, 'hold');
        phaseEl.textContent = 'Hold';
        roundEl.textContent = 'Counting up';
        hintEl.textContent = 'Stay soft. Stop at the first firm contractions.';
        nextEl.textContent = 'Tap the dial, or press stop, the moment you are done.';
        liveEl.textContent = 'Hold now.';
        dialEl.classList.add('tappable');
        if (navigator.vibrate) navigator.vibrate([90, 70, 90]);
        syncControls();
        testTick();
    }

    function skipToHold() {
        silence(); // drop the cues queued for the end of the breathe-up
        if (soundOn) {
            ensureAudio();
            cues.hold(ac.currentTime + 0.05);
        }
        beginTestHold();
    }

    function stopTestHold() {
        const secs = Math.round((performance.now() - testT0) / 1000);
        clearInterval(testTicker);
        dialEl.classList.remove('tappable');
        if (secs < TEST_MIN) {
            // the whole dial is a stop target, so a brush of the screen ends the hold
            testPhase = 'idle';
            silence();
            renderTestIdle();
            hintEl.textContent = 'That was under ' + TEST_MIN + ' seconds — nothing recorded.';
            nextEl.textContent = 'Start again when you are ready.';
            keepAwake(false);
            syncControls();
            return;
        }
        testPhase = 'result';
        lastTest = {secs, at: Date.now()};
        save();
        const suggested = suggestFor(secs);
        setRing(1, 'done');
        phaseEl.textContent = 'Comfortable hold';
        clockEl.textContent = fmt(secs);
        roundEl.textContent = 'Breathe normally now';
        hintEl.textContent = 'Recover first: easy breaths, sitting, for a minute.';
        nextEl.textContent = 'Suggested table hold ' + fmt(suggested) + '.';
        fillResult(secs);
        renderTestLast();
        liveEl.textContent = 'Comfortable hold ' + fmt(secs) + '. Suggested table hold ' + fmt(suggested) + '.';
        if (soundOn && ac) cues.done(ac.currentTime + 0.03);
        if (navigator.vibrate) navigator.vibrate([160, 90, 160]);
        keepAwake(false);
        syncControls();
    }

    function testReset() {
        clearInterval(testTicker);
        silence();
        testPhase = 'idle';
        dialEl.classList.remove('tappable');
        liveEl.textContent = '';
        renderTestIdle();
        keepAwake(false);
        syncControls();
    }

    function setMode(next) {
        if (next === mode) return;
        reset();
        testReset();
        mode = next;
        shell.dataset.mode = mode;
        modeBtns.forEach((b) => b.classList.toggle('active', b.dataset.mode === mode));
        if (mode === 'table') renderIdle();
        else renderTestIdle();
        syncControls();
    }

    function primaryAction() {
        if (mode === 'table') {
            begin(paused ? consumed : 0);
            return;
        }
        if (testPhase === 'prep') skipToHold();
        else if (testPhase === 'hold') stopTestHold();
        else beginTestPrep();
    }

    function syncControls() {
        if (mode === 'test') {
            startBtn.disabled = false;
            startBtn.textContent =
                testPhase === 'prep' ? 'Skip to hold'
                    : testPhase === 'hold' ? 'Stop'
                        : testPhase === 'result' ? 'Test again'
                            : 'Start test';
            startBtn.classList.toggle('stop', testPhase === 'hold');
            pauseBtn.disabled = true;
            resetBtn.disabled = testPhase === 'idle';
            return;
        }
        startBtn.classList.remove('stop');
        startBtn.disabled = running;
        startBtn.textContent = paused ? 'Resume' : done ? 'Run again' : 'Start';
        pauseBtn.disabled = !running;
        resetBtn.disabled = !running && !paused && !done;
        const locked = running || paused;
        setupEl.classList.toggle('locked', locked);
        setupEl.querySelectorAll('button').forEach((b) => (b.disabled = locked));
    }

    /* ================= wiring ================= */
    startBtn.addEventListener('click', primaryAction);
    pauseBtn.addEventListener('click', pause);
    resetBtn.addEventListener('click', () => (mode === 'test' ? testReset() : reset()));
    modeBtns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode)));

    // ending the hold has to be easy to hit with your eyes shut
    dialEl.addEventListener('pointerdown', () => {
        if (mode === 'test' && testPhase === 'hold') stopTestHold();
    });

    applyBtn.addEventListener('click', () => {
        if (!lastTest) return;
        settings.hold = suggestFor(lastTest.secs);
        save();
        rebuild();
        setMode('table');
        liveEl.textContent = 'Hold set to ' + fmt(settings.hold) + '.';
    });

    soundBtn.addEventListener('click', () => {
        soundOn = !soundOn;
        soundBtn.textContent = 'Sound: ' + (soundOn ? 'on' : 'off');
        soundBtn.setAttribute('aria-pressed', String(soundOn));
        soundBtn.classList.toggle('off', !soundOn);
        save();
        if (!soundOn) {
            silence();
            return;
        }
        if (mode === 'test') {
            if (testPhase !== 'idle') ensureAudio();
            return;
        }
        if (!running) return;
        ensureAudio();
        scheduleCues((performance.now() - runT0) / 1000);
    });

    setupEl.querySelectorAll('[data-field]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const key = btn.dataset.field;
            const limit = LIMITS[key];
            settings[key] = clamp(settings[key] + Number(btn.dataset.step) * limit.step, limit);
            save();
            rebuild();
        });
    });

    setupEl.querySelectorAll('[data-preset]').forEach((btn) => {
        btn.addEventListener('click', () => {
            Object.assign(settings, PRESETS[btn.dataset.preset]);
            save();
            rebuild();
        });
    });

    // pointer focus rings linger on touch devices and make the controls look stuck
    document.querySelectorAll('.controls button, .setup button, .modes button').forEach((b) => {
        b.addEventListener('pointerup', () => b.blur());
    });

    addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            if (mode === 'test') testReset();
            else reset();
            return;
        }
        if (event.code !== 'Space' && event.key !== ' ') return;
        if (event.target instanceof Element && event.target.closest('button, input, select, textarea')) return;
        event.preventDefault();
        if (mode === 'test') primaryAction();
        else if (running) pause();
        else begin(paused ? consumed : 0);
    });

    if (reducedMotion) ring.style.transition = 'none';

    load();
    soundBtn.textContent = 'Sound: ' + (soundOn ? 'on' : 'off');
    soundBtn.setAttribute('aria-pressed', String(soundOn));
    soundBtn.classList.toggle('off', !soundOn);
    rebuild();
    renderTestLast();
    syncControls();
</script>

