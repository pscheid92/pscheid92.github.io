---
const today = new Date();
---

<footer class="site-footer">
    <div class="grid">
        <p class="index copy">&copy; {today.getFullYear()} Patrick Scheid</p>
        <p class="links">
            <a href="/rss.xml">RSS</a>
            <a href="https://github.com/pscheid92" rel="me">GitHub</a>
            <a href="https://www.linkedin.com/in/pscheid92/" rel="me">LinkedIn</a>
            <a href="mailto:patrick@patrickscheid.de">patrick@patrickscheid.de</a>
        </p>
    </div>
</footer>

<style>
    .site-footer {
        padding: 2rem var(--page-pad) 3rem;
        font-size: 0.9rem;
        color: var(--color-text-muted);
    }

    .site-footer .grid {
        border-top: 1px solid var(--color-border);
        padding-top: 1.25rem;
    }

    p {
        margin: 0;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
    }

    .links a {
        color: var(--color-text-muted);
    }

    .links a:hover {
        color: var(--color-accent);
    }

    @media (max-width: 63.99rem) {
        .copy {
            margin-bottom: 0.5rem;
        }
    }
</style>
