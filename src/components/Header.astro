---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
    <div class="grid header-grid">
        <a class="wordmark index" href="/">Patrick Scheid</a>
        <nav class="nav" aria-label="Main">
            <HeaderLink href="/blog">Writing</HeaderLink>
            <HeaderLink href="/projects">Projects</HeaderLink>
            <HeaderLink href="/about">About</HeaderLink>
        </nav>
        <div class="actions">
            <ThemeToggle/>
        </div>
    </div>
</header>

<style>
    .site-header {
        padding: 1.5rem var(--page-pad) 0;
    }

    .header-grid {
        align-items: baseline;
        row-gap: 0.35rem;
    }

    .wordmark {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--color-text-heading);
        white-space: nowrap;
        letter-spacing: -0.005em;
    }

    .wordmark:hover {
        color: var(--color-accent);
    }

    .nav {
        display: flex;
        gap: 1.5rem;
        font-size: 1rem;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        align-self: center;
    }

    /* Desktop: wordmark in the index column, nav on the reading column, toggle at the far edge */
    @media (min-width: 64rem) {
        .header-grid > .nav { grid-column: text; }
        .header-grid > .actions { grid-column: text-end / wide-end; grid-row: 1; }
    }

    /* Narrow: name and toggle on the first row, nav below — no hamburger needed */
    @media (max-width: 63.99rem) {
        .header-grid {
            grid-template-columns: minmax(0, 1fr) auto;
        }

        .header-grid > .wordmark { grid-column: 1; grid-row: 1; }
        .header-grid > .actions { grid-column: 2; grid-row: 1; }
        .header-grid > .nav { grid-column: 1 / -1; grid-row: 2; }
    }
</style>
