---
interface Props {
    headings: { depth: number; slug: string; text: string }[];
    maxDepth?: 2 | 3;
}

const {headings, maxDepth = 3} = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= maxDepth);
---

<ol class="toc-list">
    {items.map((h) => (
        <li class:list={[`depth-${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
        </li>
    ))}
</ol>

<style>
    .toc-list {
        list-style: none;
        margin: 0;
        padding: 0;
        line-height: 1.4;
    }

    .toc-list li {
        margin: 0;
    }

    .toc-list a {
        display: block;
        padding: 0.3rem 0;
        color: var(--color-text-muted);
    }

    .toc-list a:hover {
        color: var(--color-text-heading);
    }

    .toc-list a.active {
        color: var(--color-text-heading);
        font-weight: 700;
    }

    .depth-3 a {
        padding-left: 1rem;
        font-size: 0.92em;
    }
</style>
